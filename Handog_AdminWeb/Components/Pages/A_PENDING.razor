@page "/admin/pending"
@rendermode InteractiveServer
@using Microsoft.Data.SqlClient
@using System.Data

<div style="display: flex; justify-content: space-between; align-items: center;">
    <div style="display: flex; align-items: center; gap: 15px;">
        <div style="border: 2px solid #E0E0E0; width: 65px; height: 65px; border-radius: 14px; display: flex; justify-content: center; align-items: center; background-color: white; overflow: hidden; box-sizing: border-box; padding: 5px;">
            <img src="/bootstrap/images/pendingIcon.png" alt="Approval Management" style="width: 100%; height: 100%; object-fit: contain;" />
        </div>
        <h1 style="font-size: 28px; font-weight: bold; color: #212529; margin: 0; text-transform: uppercase; letter-spacing: 0.5px;">Approval Management</h1>
    </div>
</div>

<div style="margin-top: 30px;">
    <div style="margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center;">
        <div style="display: flex; align-items: center; gap: 8px;">
            <h2 style="font-size: 20px; font-weight: bold; color: #212529; margin: 0; text-decoration: underline; text-underline-offset: 6px;">Pending Events</h2>
            <span style="background-color: #FF5A5F; color: white; border-radius: 50%; width: 22px; height: 22px; display: flex; justify-content: center; align-items: center; font-size: 12px; font-weight: bold;">
                @FilteredPendingEvents.Count
            </span>
        </div>

        <div style="position: relative; width: 280px; display: flex; align-items: center;">
            <img src="/bootstrap/images/searchIcon.png" alt="Search" style="position: absolute; left: 12px; width: 16px; height: 16px; object-fit: contain; pointer-events: none;" />
            <input type="text" @bind-value="SearchQuery" @bind-value:event="oninput" placeholder="Search pending..." style="width: 100%; padding: 8px 35px 8px 38px; border: 1px solid #CCCCCC; border-radius: 4px; font-size: 13px;" />
        </div>
    </div>

    <div style="background-color: white; border: 1px solid #E0E0E0; border-radius: 4px; overflow: hidden;">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 14px;">
            <thead>
                <tr style="background-color: #CFF4F6; color: #1A1A1A; border-bottom: 1px solid #BCE5E7;">
                    <th style="padding: 15px; width: 45px; text-align: center;"><input type="checkbox" @bind="SelectAll" @bind:after="ToggleSelectAll" /></th>
                    <th style="padding: 15px; font-weight: 600;">Title:</th>
                    <th style="padding: 15px; font-weight: 600;">Type:</th>
                    <th style="padding: 15px; font-weight: 600;">Organizer:</th>
                    <th style="padding: 15px; font-weight: 600;">Event Date:</th>
                    <th style="padding: 15px; font-weight: 600; text-align: center;">Actions:</th>
                </tr>
            </thead>
            <tbody>
                @if (!FilteredPendingEvents.Any())
                {
                    <tr>
                        <td colspan="6" style="padding: 30px 15px; text-align: center; color: #777777;">No events are currently awaiting approval.</td>
                    </tr>
                }
                @foreach (var ev in FilteredPendingEvents)
                {
                    <tr style="border-bottom: 1px solid #EAEAEA; background-color: @(ev.IsSelected ? "#E9ECEF" : "transparent");">
                        <td style="text-align: center;"><input type="checkbox" @bind="ev.IsSelected" /></td>
                        <td style="padding: 22px 15px; font-weight: 500;">@ev.Title</td>
                        <td style="padding: 22px 15px;">@ev.CategoryName</td>
                        <td style="padding: 22px 15px;">@ev.OrganizerName</td>
                        <td style="padding: 22px 15px;">@ev.EventDate.ToShortDateString()</td>
                        <td style="padding: 15px; text-align: center;">
                            <div style="display: flex; flex-direction: column; gap: 6px; align-items: center;">
                                <button @onclick="() => ApproveEvent(ev)" disabled="@(!ev.IsSelected)" style="background-color: #00BAC7; color: white; border: none; width: 110px; padding: 6px 0; border-radius: 6px; font-weight: 600; font-size: 12px; @(ev.IsSelected ? "cursor: pointer; opacity: 1;" : "cursor: not-allowed; opacity: 0.4;")">Approve</button>
                                <button @onclick="() => OpenDenyModal(ev)" disabled="@(!ev.IsSelected)" style="background-color: #FF5A5F; color: white; border: none; width: 110px; padding: 6px 0; border-radius: 6px; font-weight: 600; font-size: 12px; @(ev.IsSelected ? "cursor: pointer; opacity: 1;" : "cursor: not-allowed; opacity: 0.4;")">Deny</button>
                                <button @onclick="() => OpenDetailsModal(ev)" style="background-color: #6C757D; color: white; border: none; width: 110px; padding: 4px 0; border-radius: 6px; font-weight: 500; font-size: 11px; cursor: pointer; margin-top: 2px;">View Details</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (IsDetailsModalOpen && SelectedEvent != null)
{
    <div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background-color: rgba(0, 0, 0, 0.4); display: flex; justify-content: center; align-items: center; z-index: 9999; font-family: 'Segoe UI', sans-serif;">
        <div style="background-color: white; border-radius: 12px; width: 100%; max-width: 920px; padding: 30px; box-shadow: 0 10px 30px rgba(0,0,0,0.15); box-sizing: border-box; position: relative;">

            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 20px;">
                <button @onclick="CloseDetailsModal" style="background: none; border: none; cursor: pointer; display: flex; align-items: center; padding: 0;">
                    <img src="/bootstrap/images/backArrow.png" alt="Back" style="width: 32px; height: 32px; object-fit: contain;" />
                </button>
                <h1 style="font-size: 26px; font-weight: 800; color: #000000; margin: 0; text-transform: uppercase; letter-spacing: 0.5px;">Events</h1>
            </div>

            <div style="border: 1px solid #1A1A1A; border-radius: 4px; overflow: hidden; box-sizing: border-box;">

                <div style="display: flex; border-bottom: 1px solid #1A1A1A; font-size: 15px; font-weight: bold;">
                    <div style="background-color: #CFF4F6; color: #000000; padding: 14px 25px; border-right: 1px solid #1A1A1A; text-transform: uppercase; letter-spacing: 0.3px;">
                        Community Engagement
                    </div>
                    <div style="background-color: white; color: #1A1A1A; padding: 14px 25px; font-weight: 500;">
                        @SelectedEvent.CategoryName
                    </div>
                </div>

                <div style="padding: 25px; box-sizing: border-box;">
                    <h2 style="font-size: 18px; font-weight: 700; color: #777777; text-transform: uppercase; margin-top: 0; margin-bottom: 25px; border-bottom: 2px solid #777777; display: inline-block; padding-bottom: 2px;">Event Details</h2>

                    <div style="display: flex; gap: 40px; align-items: flex-start;">
                        <div style="flex: 1; display: flex; flex-direction: column; gap: 15px;">
                            <div style="display: flex; align-items: center;">
                                <label style="width: 150px; font-size: 13px; font-weight: 800; color: #000000; text-transform: uppercase;">Title:</label>
                                <input type="text" value="@SelectedEvent.Title" readonly style="flex: 1; padding: 10px 14px; border: 1px solid #1A1A1A; border-radius: 12px; font-size: 14px; background-color: #FFFFFF;" />
                            </div>
                            <div style="display: flex; align-items: center;">
                                <label style="width: 150px; font-size: 13px; font-weight: 800; color: #000000; text-transform: uppercase;">Organizer Name:</label>
                                <input type="text" value="@SelectedEvent.OrganizerName" readonly style="flex: 1; padding: 10px 14px; border: 1px solid #1A1A1A; border-radius: 12px; font-size: 14px; background-color: #FFFFFF;" />
                            </div>
                            <div style="display: flex; align-items: center;">
                                <label style="width: 150px; font-size: 13px; font-weight: 800; color: #000000; text-transform: uppercase;">Address:</label>
                                <input type="text" value="@SelectedEvent.Address" readonly style="flex: 1; padding: 10px 14px; border: 1px solid #1A1A1A; border-radius: 12px; font-size: 14px; background-color: #FFFFFF;" />
                            </div>
                            <div style="display: flex; align-items: center;">
                                <label style="width: 150px; font-size: 13px; font-weight: 800; color: #000000; text-transform: uppercase;">Venue:</label>
                                <input type="text" value="@SelectedEvent.Venue" readonly style="flex: 1; padding: 10px 14px; border: 1px solid #1A1A1A; border-radius: 12px; font-size: 14px; background-color: #FFFFFF;" />
                            </div>
                            <div style="display: flex; align-items: center;">
                                <label style="width: 150px; font-size: 13px; font-weight: 800; color: #000000; text-transform: uppercase;">Email:</label>
                                <input type="text" value="@SelectedEvent.Email" readonly style="flex: 1; padding: 10px 14px; border: 1px solid #1A1A1A; border-radius: 12px; font-size: 14px; background-color: #FFFFFF;" />
                            </div>
                            <div style="display: flex; align-items: center;">
                                <label style="width: 150px; font-size: 13px; font-weight: 800; color: #000000; text-transform: uppercase;">Contact Number:</label>
                                <input type="text" value="@SelectedEvent.ContactNum" readonly style="flex: 1; padding: 10px 14px; border: 1px solid #1A1A1A; border-radius: 12px; font-size: 14px; background-color: #FFFFFF;" />
                            </div>
                        </div>

                        <div style="flex: 1; display: flex; flex-direction: column; gap: 15px;">
                            <div style="display: flex; align-items: center;">
                                <label style="width: 150px; font-size: 13px; font-weight: 800; color: #000000; text-transform: uppercase;">Date:</label>
                                <input type="text" value="@SelectedEvent.EventDate.ToShortDateString()" readonly style="flex: 1; padding: 10px 14px; border: 1px solid #1A1A1A; border-radius: 12px; font-size: 14px; background-color: #FFFFFF;" />
                            </div>
                            <div style="display: flex; align-items: center;">
                                <label style="width: 150px; font-size: 13px; font-weight: 800; color: #000000; text-transform: uppercase;">Start Time:</label>
                                <input type="text" value="@SelectedEvent.StartTime.ToString(@"hh\:mm")" readonly style="flex: 1; padding: 10px 14px; border: 1px solid #1A1A1A; border-radius: 12px; font-size: 14px; background-color: #FFFFFF;" />
                            </div>
                            <div style="display: flex; align-items: center;">
                                <label style="width: 150px; font-size: 13px; font-weight: 800; color: #000000; text-transform: uppercase;">End Time:</label>
                                <input type="text" value="@SelectedEvent.EndTime.ToString(@"hh\:mm")" readonly style="flex: 1; padding: 10px 14px; border: 1px solid #1A1A1A; border-radius: 12px; font-size: 14px; background-color: #FFFFFF;" />
                            </div>
                            <div style="display: flex; align-items: center;">
                                <label style="width: 150px; font-size: 13px; font-weight: 800; color: #000000; text-transform: uppercase;">Max Volunteers:</label>
                                <input type="text" value="@SelectedEvent.VolunteerCapacity" readonly style="flex: 1; padding: 10px 14px; border: 1px solid #1A1A1A; border-radius: 12px; font-size: 14px; background-color: #FFFFFF;" />
                            </div>

                            <div style="display: flex; flex-direction: column; gap: 6px; margin-top: 5px;">
                                <label style="font-size: 13px; font-weight: 800; color: #000000; text-transform: uppercase;">Description:</label>
                                <textarea readonly style="width: 100%; height: 82px; padding: 12px; border: 1px solid #1A1A1A; border-radius: 12px; font-size: 14px; resize: none; background-color: #FFFFFF; box-sizing: border-box;">@SelectedEvent.Description</textarea>
                            </div>
                        </div>
                    </div>

                    <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 25px;">
                        <button @onclick="() => { CloseDetailsModal(); OpenDenyModal(SelectedEvent); }" style="background-color: #FF5A5F; color: white; border: none; padding: 10px 28px; border-radius: 8px; font-weight: bold; font-size: 14px; cursor: pointer;">Deny</button>
                        <button @onclick="() => ApproveEvent(SelectedEvent)" style="background-color: #00BAC7; color: white; border: none; padding: 10px 28px; border-radius: 8px; font-weight: bold; font-size: 14px; cursor: pointer;">Approve</button>
                    </div>

                </div>
            </div>

        </div>
    </div>
}

@if (IsDenyModalOpen && DenyTarget != null)
{
    <div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background-color: rgba(0, 0, 0, 0.4); display: flex; justify-content: center; align-items: center; z-index: 10000; font-family: 'Segoe UI', sans-serif;">
        <div style="background-color: white; border-radius: 12px; width: 100%; max-width: 480px; padding: 28px; box-shadow: 0 10px 30px rgba(0,0,0,0.15); box-sizing: border-box;">
            <h2 style="font-size: 20px; font-weight: 800; color: #212529; margin: 0 0 6px 0; text-transform: uppercase;">Deny Event</h2>
            <p style="font-size: 13px; color: #777777; margin: 0 0 18px 0;">Provide a reason for denying "<strong>@DenyTarget.Title</strong>". The organizer will see this on their app.</p>

            <textarea @bind="DenyReason" placeholder="e.g. The selected date conflicts with another locale event." style="width: 100%; height: 110px; padding: 12px; border: 1px solid #1A1A1A; border-radius: 10px; font-size: 14px; resize: none; box-sizing: border-box;"></textarea>

            @if (!string.IsNullOrEmpty(DenyValidationError))
            {
                <p style="color: #FF5A5F; font-size: 12px; margin: 8px 0 0 0;">@DenyValidationError</p>
            }

            <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 20px;">
                <button @onclick="CloseDenyModal" style="background-color: #E0E0E0; color: #212529; border: none; padding: 10px 24px; border-radius: 8px; font-weight: 600; font-size: 14px; cursor: pointer;">Cancel</button>
                <button @onclick="ConfirmDenyEvent" style="background-color: #FF5A5F; color: white; border: none; padding: 10px 24px; border-radius: 8px; font-weight: bold; font-size: 14px; cursor: pointer;">Confirm Denial</button>
            </div>
        </div>
    </div>
}

@code {
    private readonly string _connectionString = "Server = tcp:handogmobile.database.windows.net,1433;Initial Catalog = handog-mobile-v3;Persist Security Info=False;User ID = handogadmin;Password=HandogMobileDB!;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout = 30;";

    private bool SelectAll { get; set; }
    private string SearchQuery { get; set; } = string.Empty;
    private List<EventApprovalModel> PendingEventsList = new();

    // Details modal
    private bool IsDetailsModalOpen { get; set; } = false;
    private EventApprovalModel? SelectedEvent { get; set; }

    // Deny modal
    private bool IsDenyModalOpen { get; set; } = false;
    private EventApprovalModel? DenyTarget { get; set; }
    private string DenyReason { get; set; } = string.Empty;
    private string DenyValidationError { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadPendingEvents();
    }

    private async Task LoadPendingEvents()
    {
        PendingEventsList.Clear();
        using var connection = new SqlConnection(_connectionString);

        // Pull events awaiting approval, joined to organizer/category/locale for the review card.
        string query = @"
            SELECT
                E.EventNum,
                E.EventTitle,
                C.CategoryName,
                A.Firstname,
                A.Lastname,
                E.EventDate,
                E.EventDescription,
                ISNULL(A.Email, 'N/A') AS Email,
                ISNULL(A.ContactNum, 'N/A') AS ContactNum,
                E.StartTime,
                E.EndTime,
                E.EventAddress,
                E.EventVenue,
                E.VolunteerCapacity
            FROM EVENT E
            INNER JOIN EVENTCATEGORY C ON E.CategoryNum = C.CategoryNum
            INNER JOIN ACCOUNT A ON E.OrganizerNum = A.AccountNum
            WHERE E.EventStatus = 'Pending'";

        using var command = new SqlCommand(query, connection);
        await connection.OpenAsync();
        using var reader = await command.ExecuteReaderAsync();
        while (await reader.ReadAsync())
        {
            PendingEventsList.Add(new EventApprovalModel
            {
                EventNum = reader.GetInt32(0),
                Title = reader.GetString(1),
                CategoryName = reader.GetString(2),
                OrganizerName = $"{reader.GetString(3)} {reader.GetString(4)}",
                EventDate = reader.GetDateTime(5),
                Description = reader.IsDBNull(6) ? "No additional descriptive details specified." : reader.GetString(6),
                Email = reader.GetString(7),
                ContactNum = reader.GetString(8),
                StartTime = reader.IsDBNull(9) ? TimeSpan.Zero : reader.GetTimeSpan(9),
                EndTime = reader.IsDBNull(10) ? TimeSpan.Zero : reader.GetTimeSpan(10),
                Address = reader.IsDBNull(11) ? "No address specified" : reader.GetString(11),
                Venue = reader.IsDBNull(12) ? "No venue specified" : reader.GetString(12),
                VolunteerCapacity = reader.IsDBNull(13) ? 0 : reader.GetInt32(13)
            });
        }
    }

    private void OpenDetailsModal(EventApprovalModel ev)
    {
        SelectedEvent = ev;
        IsDetailsModalOpen = true;
    }

    private void CloseDetailsModal()
    {
        IsDetailsModalOpen = false;
        SelectedEvent = null;
    }

    private async Task ApproveEvent(EventApprovalModel ev)
    {
        using var connection = new SqlConnection(_connectionString);
        using var command = new SqlCommand("UPDATE EVENT SET EventStatus = 'Published', RejectionReason = NULL WHERE EventNum = @Num", connection);
        command.Parameters.AddWithValue("@Num", ev.EventNum);

        await connection.OpenAsync();
        await command.ExecuteNonQueryAsync();

        CloseDetailsModal();
        await LoadPendingEvents();
    }

    private void OpenDenyModal(EventApprovalModel ev)
    {
        DenyTarget = ev;
        DenyReason = string.Empty;
        DenyValidationError = string.Empty;
        IsDenyModalOpen = true;
    }

    private void CloseDenyModal()
    {
        IsDenyModalOpen = false;
        DenyTarget = null;
        DenyReason = string.Empty;
        DenyValidationError = string.Empty;
    }

    private async Task ConfirmDenyEvent()
    {
        if (DenyTarget == null) return;

        if (string.IsNullOrWhiteSpace(DenyReason))
        {
            DenyValidationError = "A reason is required so the organizer knows what to fix.";
            return;
        }

        using var connection = new SqlConnection(_connectionString);
        using var command = new SqlCommand("UPDATE EVENT SET EventStatus = 'Rejected', RejectionReason = @Reason WHERE EventNum = @Num", connection);
        command.Parameters.AddWithValue("@Reason", DenyReason.Trim());
        command.Parameters.AddWithValue("@Num", DenyTarget.EventNum);

        await connection.OpenAsync();
        await command.ExecuteNonQueryAsync();

        CloseDenyModal();
        await LoadPendingEvents();
    }

    private List<EventApprovalModel> FilteredPendingEvents => PendingEventsList
        .Where(p => string.IsNullOrEmpty(SearchQuery) || p.Title.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) || p.OrganizerName.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase))
        .ToList();

    private void ToggleSelectAll() => FilteredPendingEvents.ForEach(p => p.IsSelected = SelectAll);

    public class EventApprovalModel
    {
        public int EventNum { get; set; }
        public string Title { get; set; } = string.Empty;
        public string CategoryName { get; set; } = string.Empty;
        public string OrganizerName { get; set; } = string.Empty;
        public DateTime EventDate { get; set; }
        public string Description { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string ContactNum { get; set; } = string.Empty;
        public TimeSpan StartTime { get; set; }
        public TimeSpan EndTime { get; set; }
        public string Address { get; set; } = string.Empty;
        public string Venue { get; set; } = string.Empty;
        public int VolunteerCapacity { get; set; }
        public bool IsSelected { get; set; } = false;
    }
}
