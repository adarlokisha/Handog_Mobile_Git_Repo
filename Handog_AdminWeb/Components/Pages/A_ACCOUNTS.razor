@page "/admin/accounts"
@rendermode InteractiveServer
@using Microsoft.Data.SqlClient
@using System.Data

<div style="display: flex; justify-content: space-between; align-items: center;">
    <div style="display: flex; align-items: center; gap: 15px;">
        <div style="border: 2px solid #E0E0E0; width: 65px; height: 65px; border-radius: 14px; display: flex; justify-content: center; align-items: center; background-color: white; overflow: hidden; box-sizing: border-box; padding: 5px;">
            <img src="/bootstrap/images/accountIcon.png" alt="Account Management" style="width: 100%; height: 100%; object-fit: contain;" />
        </div>
        <h1 style="font-size: 28px; font-weight: bold; color: #212529; margin: 0; text-transform: uppercase; letter-spacing: 0.5px;">Account Management</h1>
    </div>

    <!-- Trigger Button (Ensure this is linked to show the modal) -->
    <button @onclick="ShowCreateAccountModal" style="background-color: #00BAC7; color: white; border: none; padding: 12px 24px; border-radius: 25px; font-weight: 600; font-size: 13px; display: flex; align-items: center; gap: 8px; cursor: pointer; box-shadow: 0 4px 10px rgba(0, 186, 199, 0.2);">
        <img src="/bootstrap/images/whitePlusIcon.png" alt="Create" style="width: 16px; height: 16px; object-fit: contain;" />
        <span>Create New Account</span>
    </button>

    @if (IsCreateModalOpen)
    {
        <!-- Backdrop overlay covering the screen -->
        <div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background-color: rgba(0, 0, 0, 0.4); display: flex; justify-content: center; align-items: center; z-index: 9999; font-family: 'Segoe UI', sans-serif;">

            <!-- Main Popup Panel -->
            <div style="background-color: white; border-radius: 12px; width: 100%; max-width: 860px; padding: 30px; box-shadow: 0 10px 30px rgba(0,0,0,0.15); box-sizing: border-box; position: relative;">

                <!-- Header Group -->
                <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 20px;">
                    <button @onclick="CloseCreateAccountModal" style="background: none; border: none; cursor: pointer; display: flex; align-items: center; padding: 0;">
                        <img src="/bootstrap/images/backArrow.png" alt="Create" style="width: 32px; height: 32px; object-fit: contain;" />
                    </button>
                    <h1 style="font-size: 26px; font-weight: 800; color: #000000; margin: 0; text-transform: uppercase; letter-spacing: 0.5px;">Create Account</h1>
                </div>

                <!-- Inner Form Content Border Container -->
                <div style="border: 1px solid #1A1A1A; padding: 25px; border-radius: 4px; position: relative; box-sizing: border-box;">

                    <h2 style="font-size: 18px; font-weight: 700; color: #777777; text-transform: uppercase; margin-top: 0; margin-bottom: 25px; border-bottom: 2px solid #777777; display: inline-block; padding-bottom: 2px;">Account Details</h2>

                    <!-- 2-Column Split Layout Wrapper -->
                    <div style="display: flex; gap: 40px; align-items: flex-start;">

                        <!-- Left Column Fields -->
                        <div style="flex: 1; display: flex; flex-direction: column; gap: 15px;">
                            <div style="display: flex; align-items: center;">
                                <label style="width: 140px; font-size: 13px; font-weight: 800; color: #000000; text-transform: uppercase;">First Name:</label>
                                <input type="text" @bind="NewAccount.FirstName" placeholder="First Name" style="flex: 1; padding: 10px 14px; border: 1px solid #1A1A1A; border-radius: 12px; font-size: 14px;" />
                            </div>
                            <div style="display: flex; align-items: center;">
                                <label style="width: 140px; font-size: 13px; font-weight: 800; color: #000000; text-transform: uppercase;">Last Name:</label>
                                <input type="text" @bind="NewAccount.LastName" placeholder="Last Name" style="flex: 1; padding: 10px 14px; border: 1px solid #1A1A1A; border-radius: 12px; font-size: 14px;" />
                            </div>
                            <div style="display: flex; align-items: center;">
                                <label style="width: 140px; font-size: 13px; font-weight: 800; color: #000000; text-transform: uppercase;">Email:</label>
                                <input type="email" @bind="NewAccount.Email" placeholder="Email" style="flex: 1; padding: 10px 14px; border: 1px solid #1A1A1A; border-radius: 12px; font-size: 14px;" />
                            </div>
                            <div style="display: flex; align-items: center;">
                                <label style="width: 140px; font-size: 13px; font-weight: 800; color: #000000; text-transform: uppercase;">Contact Num:</label>
                                <input type="text" @bind="NewAccount.ContactNum" placeholder="Contact Number" style="flex: 1; padding: 10px 14px; border: 1px solid #1A1A1A; border-radius: 12px; font-size: 14px;" />
                            </div>
                        </div>

                        <!-- Right Column Fields -->
                        <div style="flex: 1; display: flex; flex-direction: column; gap: 15px;">
                            <div style="display: flex; align-items: center;">
                                <label style="width: 120px; font-size: 13px; font-weight: 800; color: #000000; text-transform: uppercase;">Password:</label>
                                <input type="password" @bind="NewAccount.Password" placeholder="Password" style="flex: 1; padding: 10px 14px; border: 1px solid #1A1A1A; border-radius: 12px; font-size: 14px;" />
                            </div>
                            <div style="display: flex; align-items: center;">
                                <label style="width: 120px; font-size: 13px; font-weight: 800; color: #000000; text-transform: uppercase;">Role:</label>
                                <select @bind="NewAccount.Role" style="flex: 1; padding: 10px 14px; border: 1px solid #1A1A1A; border-radius: 12px; font-size: 14px; background-color: white;">
                                    <option value="Volunteer">Volunteer</option>
                                    <option value="Organizer">Organizer</option>
                                </select>
                            </div>

                            <!-- Dynamic Check: Hidden if Selected Role is Not Organizer -->
                            @if (NewAccount.Role == "Organizer")
                            {
                                <div style="display: flex; align-items: center;">
                                    <label style="width: 120px; font-size: 13px; font-weight: 800; color: #000000; text-transform: uppercase;">Church ID:</label>
                                    <input type="text" @bind="NewAccount.ChurchID" placeholder="Church ID" style="flex: 1; padding: 10px 14px; border: 1px solid #1A1A1A; border-radius: 12px; font-size: 14px;" />
                                </div>
                            }
                        </div>

                    </div>

                    <!-- Submit Control Bar Grid -->
                    <div style="display: flex; justify-content: flex-end; margin-top: 30px;">
                        <button @onclick="ExecuteCreateAccount" style="background-color: #2CD5E2; color: white; border: none; padding: 12px 35px; border-radius: 8px; font-weight: bold; font-size: 15px; cursor: pointer;">
                            Create
                        </button>
                    </div>

                </div>
            </div>
        </div>
    }
</div>

<div>
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
        <h2 style="font-size: 22px; font-weight: 600; color: #212529; margin: 0;">Account List</h2>
        <span style="font-size: 14px; color: #212529; font-weight: 500;">Accounts: <strong style="font-size: 18px;">@FilteredAccounts.Count</strong></span>
    </div>

    <div style="display: flex; justify-content: space-between; align-items: center; gap: 20px;">
        <div style="display: flex; align-items: center; gap: 15px; font-size: 14px; color: #333333;">
            <div>
                Account Role:
                <select @bind="SelectedRoleFilter" style="margin-left: 5px; padding: 6px 35px 6px 12px; border: 1px solid #CCCCCC; border-radius: 4px; background-color: white; color: #495057;">
                    <option value="All">All roles</option>
                    <option value="Organizer">Organizer</option>
                    <option value="Volunteer">Volunteer</option>
                </select>
            </div>
            <button @onclick="ClearFilters" style="background-color: #FF5A5F; color: white; border: none; padding: 6px 20px; border-radius: 4px; font-size: 13px; font-weight: 500; cursor: pointer;">Clear Filter</button>
        </div>

        <div style="position: relative; width: 280px; display: flex; align-items: center;">
            <img src="/bootstrap/images/searchIcon.png" alt="Search" style="position: absolute; left: 12px; width: 16px; height: 16px; object-fit: contain; pointer-events: none;" />
            <input type="text" @bind-value="SearchQuery" @bind-value:event="oninput" placeholder="Search by name or email..." style="width: 100%; padding: 8px 35px 8px 38px; border: 1px solid #CCCCCC; border-radius: 4px; font-size: 13px; box-sizing: border-box;" />
            @if (!string.IsNullOrEmpty(SearchQuery))
            {
                <img src="/bootstrap/images/clearIcon.png" alt="Clear" @onclick="() => SearchQuery = string.Empty" style="position: absolute; right: 12px; width: 14px; height: 14px; object-fit: contain; cursor: pointer;" />
            }
        </div>
    </div>
</div>

<div style="background-color: white; border: 1px solid #E0E0E0; border-radius: 4px; overflow: hidden; box-shadow: 0 4px 6px rgba(0,0,0,0.01); margin-top: 15px;">
    <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 14px;">
        <thead>
            <tr style="background-color: #CFF4F6; color: #1A1A1A; border-bottom: 1px solid #BCE5E7;">
                <th style="padding: 15px; width: 40px;">
                    <input type="checkbox" @bind="SelectAll" @bind:after="ToggleSelectAll" />
                </th>
                <th style="padding: 15px; font-weight: 600; color: #000000;">Email:</th>
                <th style="padding: 15px; font-weight: 600; color: #000000;">Name:</th>
                <th style="padding: 15px; font-weight: 600; color: #000000;">Contact Number:</th>
                <th style="padding: 15px; font-weight: 600; color: #000000;">Role:</th>
                <th style="padding: 15px; font-weight: 600; color: #000000;">Church ID:</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var account in FilteredAccounts)
            {
                <tr style="border-bottom: 1px solid #EAEAEA; background-color: @(account.IsSelected ? "#E9ECEF" : "transparent"); border-left: @(account.IsSelected ? "4px solid #00BAC7" : "none");">
                    <td style="padding: 15px; vertical-align: middle;">
                        <input type="checkbox" @bind="account.IsSelected" @bind:after="() => OnRowUnchecked(account)" />
                    </td>
                    <td style="padding: 15px; color: #333333; vertical-align: middle;">
                        @if (account.IsEditing && account.IsSelected)
                        {
                            <input type="text" @bind="account.Email" style="width: 100%; padding: 4px;" />
                        }
                        else
                        {
                            @account.Email
                        }
                    </td>
                    <td style="padding: 15px; color: #333333; vertical-align: middle;">
                        @if (account.IsEditing && account.IsSelected)
                        {
                            <input type="text" @bind="account.DisplayName" style="width: 100%; padding: 4px;" />
                        }
                        else
                        {
                            @account.DisplayName
                        }
                    </td>
                    <td style="padding: 15px; color: #333333; vertical-align: middle;">
                        @if (account.IsEditing && account.IsSelected)
                        {
                            <input type="text" @bind="account.ContactNumber" style="width: 100%; padding: 4px;" />
                        }
                        else
                        {
                            @account.ContactNumber
                        }
                    </td>
                    <td style="padding: 15px; color: #333333; vertical-align: middle;">
                        @if (account.IsEditing && account.IsSelected)
                        {
                            <select @bind="account.Role" style="padding: 4px;">
                                <option>Organizer</option>
                                <option>Volunteer</option>
                            </select>
                        }
                        else
                        {
                            @account.Role
                        }
                    </td>
                    <td style="padding: 15px; color: #333333; vertical-align: middle; position: relative; padding-right: 50px;">
                        @if (account.IsEditing && account.IsSelected)
                        {
                            <input type="text" @bind="account.ChurchId" style="width: 100%; padding: 4px;" />
                        }
                        else
                        {
                            @account.ChurchId
                        }
                        <div style="position: absolute; right: 15px; top: 50%; transform: translateY(-50%); display: flex; gap: 8px;">
                            @if (account.IsEditing && account.IsSelected)
                            {
                                <span class="bi bi-check-square-fill" style="color: #28a745; cursor: pointer; font-size: 18px;" @onclick="() => SaveAccountChanges(account)"></span>
                            }
                            else
                            {
                                <img src="/bootstrap/images/editIcon.png"
                                     alt="Edit"
                                     style="width: 16px; height: 16px; object-fit: contain; @(account.IsSelected ? "cursor: pointer; opacity: 1;" : "cursor: not-allowed; opacity: 0.3;")"
                                     @onclick="() => { if (account.IsSelected) account.IsEditing = true; }" />
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private readonly string _connectionString = "Server = tcp:handogmobile.database.windows.net,1433;Initial Catalog = handog-mobile-v3;Persist Security Info=False;User ID = handogadmin;Password=HandogMobileDB!;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout = 30;";

    private bool SelectAll { get; set; }
    private string SearchQuery { get; set; } = string.Empty;
    private string SelectedRoleFilter { get; set; } = "All";
    private List<AccountModel> AccountsList = new();

    private bool IsCreateModalOpen { get; set; } = false;

    private CreateAccountBindingModel NewAccount { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAccountsFromDatabase();
    }

    private async Task LoadAccountsFromDatabase()
    {
        AccountsList.Clear();
        using var connection = new SqlConnection(_connectionString);
        using var command = new SqlCommand("SELECT AccountNum, Email, Firstname, Lastname, ContactNum, AccRole, ChurchID FROM ACCOUNT", connection);

        await connection.OpenAsync();
        using var reader = await command.ExecuteReaderAsync();
        while (await reader.ReadAsync())
        {
            AccountsList.Add(new AccountModel
            {
                AccountNum = reader.GetInt32(0),
                Email = reader.GetString(1),
                DisplayName = $"{reader.GetString(2)} {reader.GetString(3)}",
                ContactNumber = reader.GetString(4),
                Role = reader.GetString(5),
                ChurchId = reader.IsDBNull(6) ? "NULL" : reader.GetString(6)
            });
        }
    }

    private async Task SaveAccountChanges(AccountModel account)
    {
        account.IsEditing = false;
        var nameParts = account.DisplayName.Split(' ', 2);
        string firstName = nameParts.Length > 0 ? nameParts[0] : account.DisplayName;
        string lastName = nameParts.Length > 1 ? nameParts[1] : string.Empty;

        using var connection = new SqlConnection(_connectionString);
        using var command = new SqlCommand(@"
            UPDATE ACCOUNT
            SET Email = @Email, Firstname = @First, Lastname = @Last, ContactNum = @Contact, AccRole = @Role, ChurchID = @Church
            WHERE AccountNum = @Num", connection);

        command.Parameters.AddWithValue("@Email", account.Email);
        command.Parameters.AddWithValue("@First", firstName);
        command.Parameters.AddWithValue("@Last", lastName);
        command.Parameters.AddWithValue("@Contact", account.ContactNumber);
        command.Parameters.AddWithValue("@Role", account.Role);
        command.Parameters.AddWithValue("@Church", account.ChurchId == "NULL" ? DBNull.Value : account.ChurchId);
        command.Parameters.AddWithValue("@Num", account.AccountNum);

        await connection.OpenAsync();
        await command.ExecuteNonQueryAsync();
    }

    private void ShowCreateAccountModal()
    {
        NewAccount = new CreateAccountBindingModel { Role = "Volunteer" };
        IsCreateModalOpen = true;
    }

    private void CloseCreateAccountModal()
    {
        IsCreateModalOpen = false;
    }

    private async Task ExecuteCreateAccount()
    {
        if (NewAccount.Role != "Organizer")
        {
            NewAccount.ChurchID = string.Empty;
        }

        using var connection = new SqlConnection(_connectionString);
        await connection.OpenAsync();

        // 1. Calculate the next available sequence number for this specific role
        string prefix = NewAccount.Role == "Organizer" ? "ORG" : "VOL";
        string countQuery = "SELECT COUNT(*) + 1 FROM ACCOUNT WHERE AccRole = @Role";

        int nextSequence = 1;
        using (var countCmd = new SqlCommand(countQuery, connection))
        {
            countCmd.Parameters.AddWithValue("@Role", NewAccount.Role);
            nextSequence = (int)await countCmd.ExecuteScalarAsync();
        }

        // 2. Format it into your exact layout pattern (e.g., ORG00003 or VOL00021)
        string generatedAccountId = $"{prefix}{nextSequence:D5}";

        // 3. Run the updated INSERT statement containing Account_ID
        string sqlQuery = @"
        INSERT INTO ACCOUNT (Account_ID, Firstname, Lastname, Email, ContactNum, AccPassword, AccRole, AccountStatus, ChurchID, AbsenceCount)
        VALUES (@AccountId, @First, @Last, @Email, @Contact, @Password, @Role, 'Active', @ChurchID, 0)";

        using var command = new SqlCommand(sqlQuery, connection);
        command.Parameters.AddWithValue("@AccountId", generatedAccountId); // ⬅️ Attached string sequence
        command.Parameters.AddWithValue("@First", NewAccount.FirstName);
        command.Parameters.AddWithValue("@Last", NewAccount.LastName);
        command.Parameters.AddWithValue("@Email", NewAccount.Email);
        command.Parameters.AddWithValue("@Contact", NewAccount.ContactNum);
        command.Parameters.AddWithValue("@Password", NewAccount.Password);
        command.Parameters.AddWithValue("@Role", NewAccount.Role);
        command.Parameters.AddWithValue("@ChurchID", string.IsNullOrWhiteSpace(NewAccount.ChurchID) ? DBNull.Value : NewAccount.ChurchID);

        await command.ExecuteNonQueryAsync();

        IsCreateModalOpen = false;
        await LoadAccountsFromDatabase();
    }

    private List<AccountModel> FilteredAccounts => AccountsList
        .Where(a => string.IsNullOrEmpty(SearchQuery) ||
                    a.DisplayName.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ||
                    a.Email.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase))
        .Where(a => SelectedRoleFilter == "All" || a.Role.Equals(SelectedRoleFilter, StringComparison.OrdinalIgnoreCase))
        .ToList();

    private void ToggleSelectAll()
    {
        foreach (var account in FilteredAccounts)
        {
            account.IsSelected = SelectAll;
            if (!SelectAll) account.IsEditing = false;
        }
    }

    private void OnRowUnchecked(AccountModel account)
    {
        if (!account.IsSelected)
        {
            account.IsEditing = false;
            SelectAll = false;
        }
    }

    private void ClearFilters()
    {
        SelectedRoleFilter = "All";
        SearchQuery = string.Empty;
    }

    public class AccountModel
    {
        public int AccountNum { get; set; }
        public string Email { get; set; } = string.Empty;
        public string DisplayName { get; set; } = string.Empty;
        public string ContactNumber { get; set; } = string.Empty;
        public string Role { get; set; } = string.Empty;
        public string ChurchId { get; set; } = string.Empty;
        public bool IsSelected { get; set; } = false;
        public bool IsEditing { get; set; } = false;
    }

    public class CreateAccountBindingModel
    {
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string ContactNum { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string Role { get; set; } = "Volunteer";
        public string ChurchID { get; set; } = string.Empty;
    }
}