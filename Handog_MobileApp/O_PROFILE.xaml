<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Handog_MobileApp.O_PROFILE"
             Title="Organizer Profile"
             BackgroundColor="#F4F6F8"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto, *, Auto">

        <VerticalStackLayout Grid.Row="0" Spacing="0" BackgroundColor="#FAD02C" IgnoreSafeArea="True" Padding="0, 48, 0, 16">
            <Grid ColumnDefinitions="Auto, *, Auto" Padding="16, 0">
                <ImageButton Grid.Column="0"
                             Source="back_black.png" 
                             Clicked="BackBtn_Clicked"
                             WidthRequest="24" 
                             HeightRequest="24"
                             BackgroundColor="Transparent"
                             VerticalOptions="Center"
                             HorizontalOptions="Start"/>

                <HorizontalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="4">
                    <Label Text="Hi," FontSize="14" TextColor="#1A1A1A" Opacity="0.7" VerticalOptions="Center"/>
                    <Label x:Name="LblHeaderUsername" Text="Organizer!" TextColor="#1A1A1A" FontSize="15" FontAttributes="Bold" VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Grid>

            <VerticalStackLayout Padding="24, 16, 24, 0" HorizontalOptions="Center" Spacing="8">
                <Image Source="profile_black.png" HeightRequest="44" WidthRequest="44" HorizontalOptions="Center" />
                <Label Text="PROFILE" TextColor="#1A1A1A" FontAttributes="Bold" FontSize="26" CharacterSpacing="1" HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </VerticalStackLayout>

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="16" Padding="16,20,16,24">

                <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="White">
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,2" Radius="6" Opacity="0.04"/>
                    </Border.Shadow>

                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="16" Padding="20">
                        <Grid Grid.Column="0" WidthRequest="70" HeightRequest="70" VerticalOptions="Center">
                            <Ellipse Stroke="#E0E0E0" StrokeThickness="1.5" WidthRequest="70" HeightRequest="70"/>
                            <Line X1="13" Y1="13" X2="57" Y2="57" Stroke="#E0E0E0" StrokeThickness="1.5"/>
                            <Line X1="57" Y1="13" X2="13" Y2="57" Stroke="#E0E0E0" StrokeThickness="1.5"/>
                        </Grid>

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label x:Name="LblFullName" Text="Loading Name..." TextColor="#1A1A1A" FontAttributes="Bold" FontSize="18"/>
                            <Label x:Name="LblAccountID" Text="Loading ID..." TextColor="#777777" FontSize="12" FontAttributes="Italic"/>
                            <BoxView HeightRequest="1" BackgroundColor="#F0F2F5" Margin="0,6,0,4"/>
                            <Label Text="ORGANIZER" TextColor="#00BAC7" FontAttributes="Bold" FontSize="12" CharacterSpacing="1"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <VerticalStackLayout Spacing="6">
                    <Label Text="STATISTICS" TextColor="#777777" FontAttributes="Bold" FontSize="11" Margin="4,0,0,0"/>

                    <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="White">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,2" Radius="6" Opacity="0.04"/>
                        </Border.Shadow>

                        <Grid ColumnDefinitions="*, *, *" Padding="12,20">
                            <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="4">
                                <Label x:Name="LblCountOrganized" Text="0" TextColor="#1A1A1A" FontAttributes="Bold" FontSize="26" HorizontalOptions="Center"/>
                                <Label Text="Organized" TextColor="#777777" FontSize="12" HorizontalOptions="Center"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4">
                                <Label x:Name="LblCountJoined" Text="0" TextColor="#1A1A1A" FontAttributes="Bold" FontSize="26" HorizontalOptions="Center"/>
                                <Label Text="Joined" TextColor="#777777" FontSize="12" HorizontalOptions="Center"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="4">
                                <Label x:Name="LblCountAbsences" Text="0" TextColor="#1A1A1A" FontAttributes="Bold" FontSize="26" HorizontalOptions="Center"/>
                                <Label Text="Absences" TextColor="#777777" FontSize="12" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="UNIQUE QR CODE" TextColor="#777777" FontAttributes="Bold" FontSize="11" Margin="4,0,0,0"/>

                    <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="White">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,2" Radius="6" Opacity="0.04"/>
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="12" Padding="24">
                            <Border x:Name="QrCodeContainer"
                                    HeightRequest="220" 
                                    WidthRequest="220" 
                                    StrokeThickness="0"
                                    BackgroundColor="#F9F9F9"
                                    StrokeShape="RoundRectangle 8"
                                    HorizontalOptions="Center" 
                                    VerticalOptions="Center">
                                <Image Source="qr_placeholder_wireframe.png" Aspect="AspectFit" Margin="10"/>
                            </Border>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <Button Text="LOGOUT"
                        BackgroundColor="#1A1A1A"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="12"
                        HeightRequest="44"
                        WidthRequest="120"
                        CornerRadius="22"
                        Padding="0"
                        Margin="0,12,0,0"
                        HorizontalOptions="Center"
                        Clicked="LogoutBtn_Clicked"/>

            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="2" 
                BackgroundColor="#FAD02C" 
                StrokeShape="RoundRectangle 20,20,0,0" 
                StrokeThickness="0" 
                HeightRequest="60" 
                Padding="12, 0">

            <Grid ColumnDefinitions="*, *, *, *">
                <ImageButton Grid.Column="0" Source="home.png" Clicked="HomeBtn_Clicked" HorizontalOptions="Center" VerticalOptions="Center" HeightRequest="24" WidthRequest="24" BackgroundColor="Transparent"/>
                <ImageButton Grid.Column="1" Source="proposals.png" Clicked="ProposalsBtn_Clicked" HorizontalOptions="Center" VerticalOptions="Center" HeightRequest="24" WidthRequest="24" BackgroundColor="Transparent"/>
                <ImageButton Grid.Column="2" Source="events.png" Clicked="EventsBtn_Clicked" HorizontalOptions="Center" VerticalOptions="Center" HeightRequest="28" WidthRequest="28" BackgroundColor="Transparent"/>
                <ImageButton Grid.Column="3" Source="profile.png" HorizontalOptions="Center" VerticalOptions="Center" HeightRequest="24" WidthRequest="24" BackgroundColor="Transparent"/>
            </Grid>
        </Border>

    </Grid>
</ContentPage>