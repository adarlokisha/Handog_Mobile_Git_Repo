<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Handog_MobileApp.O_PROFILE"
             Title="Organizer Profile"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto, *, Auto">

        <VerticalStackLayout Grid.Row="0" Spacing="0">
            <Grid ColumnDefinitions="Auto, *, Auto" Padding="16">
                <ImageButton Grid.Column="0"
                             Source="back_black.png" 
                             Clicked="BackBtn_Clicked"
                             WidthRequest="24" 
                             HeightRequest="24"
                             BackgroundColor="Transparent"
                             VerticalOptions="Center"
                             HorizontalOptions="Start"/>

                <HorizontalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="4">
                    <Label Text="Hi," FontSize="15" Opacity="0.8" VerticalOptions="Center"/>
                    <Label x:Name="LblHeaderUsername" Text="Organizer!" FontSize="15" FontAttributes="Bold" VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Grid>

            <VerticalStackLayout Padding="24, 20, 24, 12" HorizontalOptions="Center" Spacing="8">
                <Image Source="profile_black.png" HeightRequest="44" WidthRequest="44" HorizontalOptions="Center" />
                <Label Text="PROFILE" FontAttributes="Bold" FontSize="26" CharacterSpacing="1" HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </VerticalStackLayout>

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="16" Padding="16,12,16,24">

                <Border StrokeShape="RoundRectangle 8" StrokeThickness="1" Padding="16">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="16">
                        <Grid Grid.Column="0" WidthRequest="70" HeightRequest="70" VerticalOptions="Center">
                            <Ellipse StrokeThickness="1.5" WidthRequest="70" HeightRequest="70"/>
                            <Line X1="13" Y1="13" X2="57" Y2="57" StrokeThickness="1.5"/>
                            <Line X1="57" Y1="13" X2="13" Y2="57" StrokeThickness="1.5"/>
                        </Grid>

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label x:Name="LblFullName" Text="Loading Name..." FontAttributes="Bold" FontSize="20"/>
                            <Label x:Name="LblAccountID" Text="Loading ID..." FontSize="12" FontAttributes="Italic"/>
                            <BoxView HeightRequest="1" Margin="0,4,0,2"/>
                            <Label Text="ORGANIZER" FontAttributes="Bold" FontSize="13"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <VerticalStackLayout Spacing="6">
                    <Label Text="STATISTICS" FontAttributes="Bold" FontSize="11" Margin="4,0,0,0"/>

                    <Border StrokeShape="RoundRectangle 8" StrokeThickness="1" Padding="12,16">
                        <Grid ColumnDefinitions="*, *, *">
                            <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="4">
                                <Label x:Name="LblCountOrganized" Text="0" FontAttributes="Bold" FontSize="26" HorizontalOptions="Center"/>
                                <Label Text="Organized" FontSize="12" HorizontalOptions="Center"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4">
                                <Label x:Name="LblCountJoined" Text="0" FontAttributes="Bold" FontSize="26" HorizontalOptions="Center"/>
                                <Label Text="Joined" FontSize="12" HorizontalOptions="Center"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="4">
                                <Label x:Name="LblCountAbsences" Text="0" FontAttributes="Bold" FontSize="26" HorizontalOptions="Center"/>
                                <Label Text="Absences" FontSize="12" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="UNIQUE QR CODE" FontAttributes="Bold" FontSize="11" Margin="4,0,0,0"/>

                    <Border StrokeShape="RoundRectangle 12" StrokeThickness="1" Padding="20">
                        <VerticalStackLayout Spacing="12">
                            <Border x:Name="QrCodeContainer"
                                    HeightRequest="240" 
                                    WidthRequest="240" 
                                    StrokeThickness="0"
                                    HorizontalOptions="Center" 
                                    VerticalOptions="Center">
                                <Image Source="qr_placeholder_wireframe.png" Aspect="AspectFit"/>
                            </Border>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <Button Text="LOGOUT"
                        FontAttributes="Bold"
                        FontSize="12"
                        HeightRequest="32"
                        WidthRequest="94"
                        CornerRadius="16"
                        Padding="0"
                        Margin="0,8,0,0"
                        HorizontalOptions="Center"
                        Clicked="LogoutBtn_Clicked"/>

            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="2" StrokeShape="RoundRectangle 20,20,0,0" StrokeThickness="0" HeightRequest="60" Padding="12, 0">
            <Grid ColumnDefinitions="*, *, *, *">
                <ImageButton Grid.Column="0" Source="home.png" Clicked="HomeBtn_Clicked" HorizontalOptions="Center" VerticalOptions="Center" HeightRequest="24" WidthRequest="24" BackgroundColor="Transparent"/>
                <ImageButton Grid.Column="1" Source="proposals.png" Clicked="ProposalsBtn_Clicked" HorizontalOptions="Center" VerticalOptions="Center" HeightRequest="24" WidthRequest="24" BackgroundColor="Transparent"/>
                <ImageButton Grid.Column="2" Source="events.png" Clicked="EventsBtn_Clicked" HorizontalOptions="Center" VerticalOptions="Center" HeightRequest="28" WidthRequest="28" BackgroundColor="Transparent"/>
                <ImageButton Grid.Column="3" Source="profile.png" HorizontalOptions="Center" VerticalOptions="Center" HeightRequest="24" WidthRequest="24" BackgroundColor="Transparent"/>
            </Grid>
        </Border>

    </Grid>
</ContentPage>