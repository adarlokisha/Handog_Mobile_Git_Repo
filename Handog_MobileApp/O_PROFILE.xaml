<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Handog_MobileApp.O_PROFILE"
             BackgroundColor="#F4F6F8"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto, *, Auto" BackgroundColor="#F4F6F8">

        <VerticalStackLayout Grid.Row="0" Spacing="0" BackgroundColor="#F4F6F8">
            <Grid BackgroundColor="#FAD02C" ColumnDefinitions="Auto, *, Auto" Padding="16, 16, 16, 16">
                <ImageButton Grid.Column="0"
                             Source="back_black.png" 
                             Clicked="BackBtn_Clicked"
                             WidthRequest="24" HeightRequest="24"
                             BackgroundColor="Transparent"
                             VerticalOptions="Center"
                             HorizontalOptions="Start"/>

                <HorizontalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="4">
                    <Label Text="Hi," TextColor="#1A1A1A" FontSize="15" Opacity="0.8" VerticalOptions="Center"/>
                    <Label Text="Username!" TextColor="#1A1A1A" FontSize="15" FontAttributes="Bold" VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Grid>

            <VerticalStackLayout Padding="24, 20, 24, 12" HorizontalOptions="Center" Spacing="8">
                <Image Source="profile_black.png" HeightRequest="44" WidthRequest="44" HorizontalOptions="Center" />
                <Label Text="PROFILE" TextColor="#1A1A1A" FontAttributes="Bold" FontSize="26" CharacterSpacing="1" HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </VerticalStackLayout>

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="16" Padding="16,12,16,24">

                <Border StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#CCCCCC" BackgroundColor="White" Padding="16">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="16">
                        <Grid Grid.Column="0" WidthRequest="70" HeightRequest="70" VerticalOptions="Center">
                            <Ellipse Stroke="#1A1A1A" StrokeThickness="1.5" WidthRequest="70" HeightRequest="70"/>
                            <Line X1="13" Y1="13" X2="57" Y2="57" Stroke="#1A1A1A" StrokeThickness="1.5"/>
                            <Line X1="57" Y1="13" X2="13" Y2="57" Stroke="#1A1A1A" StrokeThickness="1.5"/>
                        </Grid>

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="FNAME LNAME" TextColor="#000000" FontAttributes="Bold" FontSize="20"/>
                            <Label Text="USERID" TextColor="#888888" FontSize="12" FontAttributes="Italic"/>
                            <BoxView HeightRequest="1" BackgroundColor="#CCCCCC" Margin="0,4,0,2"/>
                            <Label Text="ORGANIZER" TextColor="#FAD02C" FontAttributes="Bold" FontSize="13"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <VerticalStackLayout Spacing="6">
                    <Label Text="STATISTICS" TextColor="#555555" FontAttributes="Bold" FontSize="11" Margin="4,0,0,0"/>

                    <Border StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#CCCCCC" BackgroundColor="White" Padding="12,16">
                        <Grid ColumnDefinitions="*, *, *">
                            <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="4">
                                <Label Text="3" TextColor="#FAD02C" FontAttributes="Bold" FontSize="26" HorizontalOptions="Center"/>
                                <Label Text="Organized" TextColor="#555555" FontSize="12" HorizontalOptions="Center"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4">
                                <Label Text="5" TextColor="#FAD02C" FontAttributes="Bold" FontSize="26" HorizontalOptions="Center"/>
                                <Label Text="Joined" TextColor="#555555" FontSize="12" HorizontalOptions="Center"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="4">
                                <Label Text="0" TextColor="#FF0033" FontAttributes="Bold" FontSize="26" HorizontalOptions="Center"/>
                                <Label Text="Absences" TextColor="#555555" FontSize="12" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="UNIQUE QR CODE" TextColor="#555555" FontAttributes="Bold" FontSize="11" Margin="4,0,0,0"/>

                    <Border StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#CCCCCC" BackgroundColor="White" Padding="20">
                        <VerticalStackLayout Spacing="12">
                            <Border x:Name="QrCodeContainer"
                                    HeightRequest="240" 
                                    WidthRequest="240" 
                                    StrokeThickness="0"
                                    BackgroundColor="#EFEFEF" 
                                    HorizontalOptions="Center" 
                                    VerticalOptions="Center">
                                <Image Source="qr_placeholder_wireframe.png" Aspect="AspectFit"/>
                            </Border>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <Button Text="LOGOUT"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="12"
                        BackgroundColor="#E60026"
                        HeightRequest="32"
                        WidthRequest="94"
                        CornerRadius="16"
                        Padding="0"
                        Margin="0,8,0,0"
                        HorizontalOptions="Center"
                        Clicked="LogoutBtn_Clicked"/>

            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="2" BackgroundColor="#FAD02C" StrokeShape="RoundRectangle 20,20,0,0" StrokeThickness="0" HeightRequest="60" Padding="12, 0">
            <Grid ColumnDefinitions="*, *, *, *">
                <ImageButton Grid.Column="0" Source="home.png" Clicked="HomeBtn_Clicked" HorizontalOptions="Center" VerticalOptions="Center" HeightRequest="24" WidthRequest="24" BackgroundColor="Transparent"/>
                <ImageButton Grid.Column="1" Source="proposals.png" Clicked="ProposalsBtn_Clicked" HorizontalOptions="Center" VerticalOptions="Center" HeightRequest="24" WidthRequest="24" BackgroundColor="Transparent"/>
                <ImageButton Grid.Column="2" Source="events.png" Clicked="EventsBtn_Clicked" HorizontalOptions="Center" VerticalOptions="Center" HeightRequest="28" WidthRequest="28" BackgroundColor="Transparent"/>
                <ImageButton Grid.Column="3" Source="profile.png" HorizontalOptions="Center" VerticalOptions="Center" HeightRequest="24" WidthRequest="24" BackgroundColor="Transparent"/>
            </Grid>
        </Border>

    </Grid>
</ContentPage>