<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Handog_MobileApp.O_EVENTS"
             BackgroundColor="#F4F6F8"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto, *, Auto" BackgroundColor="#F4F6F8">

        <VerticalStackLayout Grid.Row="0" Spacing="0" BackgroundColor="#F4F6F8">
            <Grid BackgroundColor="#FAD02C" ColumnDefinitions="Auto, *, Auto" Padding="16, 16, 16, 16">
                <ImageButton Grid.Column="0"
                             Source="back_black.png" 
                             Clicked="BackBtn_Clicked"
                             WidthRequest="24" HeightRequest="24"
                             BackgroundColor="Transparent"
                             VerticalOptions="Center"
                             HorizontalOptions="Start"/>

                <HorizontalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="4">
                    <Label Text="Hi," TextColor="#1A1A1A" FontSize="15" Opacity="0.8" VerticalOptions="Center"/>
                    <Label Text="Username!" TextColor="#1A1A1A" FontSize="15" FontAttributes="Bold" VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Grid>

            <VerticalStackLayout Padding="24, 24, 24, 16" HorizontalOptions="Center" Spacing="8">
                <Image Source="events_black.png" HeightRequest="44" WidthRequest="44" HorizontalOptions="Center" />
                <Label Text="EVENTS" TextColor="#1A1A1A" FontAttributes="Bold" FontSize="26" CharacterSpacing="1" HorizontalOptions="Center"/>

                <Border StrokeShape="RoundRectangle 12" 
                        StrokeThickness="0" 
                        Stroke="Transparent"
                        BackgroundColor="White"
                        HeightRequest="46" 
                        WidthRequest="320"
                        Margin="0,8,0,0">
                    <SearchBar Placeholder="Search events..."
                               PlaceholderColor="#999999"
                               TextColor="#1A1A1A"
                               BackgroundColor="Transparent"/>
                </Border>
            </VerticalStackLayout>

            <Border Margin="16,8" StrokeShape="RoundRectangle 20" StrokeThickness="1" Stroke="Transparent" BackgroundColor="#EFEFEF" Padding="2" HorizontalOptions="Fill">
                <Grid ColumnDefinitions="*, *, *">
                    <Border Grid.Column="0" StrokeShape="RoundRectangle 18" StrokeThickness="0" Stroke="Transparent" BackgroundColor="White">
                        <Label Text="My Events" TextColor="#1A1A1A" FontAttributes="Bold" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center" Padding="0,8"/>
                    </Border>
                    <Label Grid.Column="1" Text="All Events" TextColor="#555555" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center"/>
                    <Label Grid.Column="2" Text="Completed" TextColor="#555555" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Grid>
            </Border>
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" 
                        Margin="16,0" 
                        SelectionMode="None">

            <CollectionView.Footer>
                <BoxView HeightRequest="80" Color="Transparent"/>
            </CollectionView.Footer>

            <CollectionView.ItemsSource>
                <x:Array Type="{x:Type x:String}">
                    <x:String>Soup Kitchen Initiative</x:String>
                    <x:String>Coastal Clean-Up Drive</x:String>
                    <x:String>Barangay Tree Planting</x:String>
                    <x:String>Disaster Relief Packaging</x:String>
                    <x:String>Stray Animal Feeding</x:String>
                    <x:String>Youth IT Bootcamp Seminar</x:String>
                </x:Array>
            </CollectionView.ItemsSource>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,6" StrokeShape="RoundRectangle 12" StrokeThickness="0" Stroke="Transparent" BackgroundColor="White">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,2" Radius="6" Opacity="0.04"/>
                        </Border.Shadow>

                        <Grid ColumnDefinitions="*, 110" HeightRequest="130">
                            <VerticalStackLayout Grid.Column="0" Padding="14" Spacing="4" VerticalOptions="Center">
                                <Label Text="{Binding .}" TextColor="#1A1A1A" FontAttributes="Bold" FontSize="15" LineBreakMode="TailTruncation"/>

                                <VerticalStackLayout Spacing="1" Margin="0,2,0,0">
                                    <Label Text="• VENUE: BRGY. HALL AUDITORIUM" TextColor="#777777" FontSize="10"/>
                                    <Label Text="• ADDRESS: North Point, Pula, Cabuyao, Laguna" TextColor="#777777" FontSize="10" LineBreakMode="TailTruncation"/>
                                    <Label Text="• TIME: 8:00 AM - 1:30 PM" TextColor="#777777" FontSize="10"/>
                                    <Label Text="• DATE: August 21, 2026" TextColor="#777777" FontSize="10"/>
                                    <Label Text="• DETAIL: Identification IDs and kits provided." TextColor="#777777" FontSize="10" LineBreakMode="TailTruncation"/>
                                </VerticalStackLayout>
                            </VerticalStackLayout>

                            <Grid Grid.Column="1">
                                <Image Source="image_a16d41.jpg" Aspect="AspectFill"/>
                                <BoxView BackgroundColor="#00BAC7" Opacity="0.2"/>

                                <Border HeightRequest="28" WidthRequest="64" StrokeShape="RoundRectangle 14" StrokeThickness="0" Stroke="Transparent" BackgroundColor="#FAD02C" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Button Text="VIEW" 
                                            TextColor="#1A1A1A" 
                                            FontAttributes="Bold" 
                                            FontSize="11"
                                            BackgroundColor="Transparent"
                                            Padding="0"/>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.Row="1" VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,0,16">
            <Border HeightRequest="44" 
                    WidthRequest="140"
                    StrokeShape="RoundRectangle 22" 
                    StrokeThickness="0" 
                    Stroke="Transparent"
                    BackgroundColor="#00BAC7">
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,4" Radius="8" Opacity="0.15"/>
                </Border.Shadow>
                <Button Text="+ ORGANIZE" 
                        TextColor="White" 
                        FontAttributes="Bold" 
                        FontSize="13"
                        BackgroundColor="Transparent"
                        Padding="0"/>
            </Border>
        </Grid>

        <Border Grid.Row="2" BackgroundColor="#FAD02C" StrokeShape="RoundRectangle 20,20,0,0" StrokeThickness="0" HeightRequest="60" Padding="12, 0">
            <Grid ColumnDefinitions="*, *, *, *">
                <ImageButton Grid.Column="0" Source="home.png" Clicked="HomeBtn_Clicked" HorizontalOptions="Center" VerticalOptions="Center" HeightRequest="24" WidthRequest="24" BackgroundColor="Transparent"/>
                <ImageButton Grid.Column="1" Source="proposals.png" Clicked="ProposalsBtn_Clicked" HorizontalOptions="Center" VerticalOptions="Center" HeightRequest="24" WidthRequest="24" BackgroundColor="Transparent"/>
                <ImageButton Grid.Column="2" Source="events.png" HorizontalOptions="Center" VerticalOptions="Center" HeightRequest="28" WidthRequest="28" BackgroundColor="Transparent"/>
                <ImageButton Grid.Column="3" Source="profile.png" Clicked="ProfileBtn_Clicked" HorizontalOptions="Center" VerticalOptions="Center" HeightRequest="24" WidthRequest="24" BackgroundColor="Transparent"/>
            </Grid>
        </Border>

    </Grid>
</ContentPage>