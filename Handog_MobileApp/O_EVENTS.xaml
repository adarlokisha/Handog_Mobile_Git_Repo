<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Handog_MobileApp"
             x:Class="Handog_MobileApp.O_EVENTS"
             BackgroundColor="#F4F6F8"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto, *, Auto">

        <VerticalStackLayout Grid.Row="0" Spacing="0" BackgroundColor="#FAD02C" IgnoreSafeArea="True" Padding="0, 48, 0, 16">
            <Grid ColumnDefinitions="Auto, *, Auto" Padding="16, 0">
                <ImageButton Grid.Column="0" Source="back_black.png" Command="{Binding BackCommand}" WidthRequest="24" HeightRequest="24" BackgroundColor="Transparent"/>
                <HorizontalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="4">
                    <Label Text="Hi," FontSize="14" TextColor="#1A1A1A" Opacity="0.7" VerticalOptions="Center"/>
                    <Label Text="{Binding OrganizerNameHeader}" TextColor="#1A1A1A" FontSize="15" FontAttributes="Bold" VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Grid>

            <VerticalStackLayout Padding="24, 16, 24, 0" HorizontalOptions="Center" Spacing="8">
                <Image Source="events_black.png" HeightRequest="44" WidthRequest="44" HorizontalOptions="Center" />
                <Label Text="EVENTS" TextColor="#1A1A1A" FontAttributes="Bold" FontSize="26" CharacterSpacing="1" HorizontalOptions="Center"/>

                <Border StrokeShape="RoundRectangle 22" StrokeThickness="0" BackgroundColor="White" HeightRequest="44" WidthRequest="320" Margin="0,8,0,0">
                    <SearchBar Text="{Binding SearchQuery}" Placeholder="Search events..." TextColor="#1A1A1A" BackgroundColor="Transparent"/>
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>

        <Grid Grid.Row="1" RowDefinitions="Auto, *">

            <Border Grid.Row="0" Margin="16,16,16,0" StrokeShape="RoundRectangle 20" StrokeThickness="0" BackgroundColor="#EFEFEF" Padding="2">
                <Grid ColumnDefinitions="*, *, *">
                    <Border Grid.Column="0" StrokeShape="RoundRectangle 18" StrokeThickness="0" BackgroundColor="{Binding MyEventsTabColor}">
                        <Label Text="My Events" FontAttributes="Bold" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center" Padding="0,8"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SwitchTabCommand}" CommandParameter="MyEvents"/>
                        </Border.GestureRecognizers>
                    </Border>
                    <Border Grid.Column="1" StrokeShape="RoundRectangle 18" StrokeThickness="0" BackgroundColor="{Binding AllEventsTabColor}">
                        <Label Text="All Events" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center" Padding="0,8"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SwitchTabCommand}" CommandParameter="AllEvents"/>
                        </Border.GestureRecognizers>
                    </Border>
                    <Border Grid.Column="2" StrokeShape="RoundRectangle 18" StrokeThickness="0" BackgroundColor="{Binding CompletedTabColor}">
                        <Label Text="Completed" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center" Padding="0,8"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SwitchTabCommand}" CommandParameter="Completed"/>
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>
            </Border>

            <CollectionView Grid.Row="1" Margin="16,8,16,0" SelectionMode="None" ItemsSource="{Binding GlobalEventsList}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,6" Stroke="#FFFFFF" StrokeThickness="1" StrokeShape="RoundRectangle 16" BackgroundColor="White" Padding="0">
                            <Grid ColumnDefinitions="*, *" MinimumHeightRequest="150">

                                <VerticalStackLayout Grid.Column="0" Padding="12" Spacing="2">

                                    <Button Text="X" 
                                        IsVisible="{Binding IsMyEvent}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:EventsViewModel}}, Path=DeleteEventCommand}" 
                                        CommandParameter="{Binding .}" 
                                        BackgroundColor="Red" TextColor="White" FontAttributes="Bold"
                                        WidthRequest="24" HeightRequest="24" CornerRadius="4" Padding="0"
                                        HorizontalOptions="Start" Margin="0,0,0,4"/>

                                    <Label Text="{Binding EventTitle}" FontAttributes="Bold" FontSize="15" TextColor="#1A1A1A" TextDecorations="Underline" LineBreakMode="TailTruncation"/>

                                    <VerticalStackLayout Spacing="2" Margin="0,6,0,6">
                                        <Label Text="{Binding EventVenue, StringFormat='• {0}'}" TextColor="#777777" FontSize="12" LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding EventDate, StringFormat='• {0}'}" TextColor="#777777" FontSize="12"/>
                                        <Label Text="{Binding EventTime, StringFormat='• {0}'}" TextColor="#777777" FontSize="12"/>
                                    </VerticalStackLayout>

                                    <Label Text="{Binding EventDetails}" TextColor="#777777" FontSize="12" LineBreakMode="TailTruncation" MaxLines="2"/>
                                </VerticalStackLayout>

                                <Grid Grid.Column="1" Padding="0">

                                    <Image Source="{Binding CategoryImage}" Aspect="AspectFill" />

                                    <Button Text="VIEW DETAILS" 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:EventsViewModel}}, Path=ViewEventDetailsCommand}" 
                                        CommandParameter="{Binding .}" 
                                        BackgroundColor="#FAD02C" TextColor="#1A1A1A" FontAttributes="Bold" FontSize="12" 
                                        CornerRadius="16" HorizontalOptions="Center" VerticalOptions="Center" 
                                        HeightRequest="36" Padding="16,0"/>
                                </Grid>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Grid.Row="1" Text="+ ORGANIZE" Command="{Binding TogglePanelCommand}" CommandParameter="OpenOrganize" BackgroundColor="#00BAC7" TextColor="White" FontAttributes="Bold" CornerRadius="22" HeightRequest="44" WidthRequest="140" HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,16"/>
        </Grid>

        <Grid Grid.RowSpan="3" BackgroundColor="#80000000" IsVisible="{Binding IsOrganizePanelVisible}" Padding="20">
            <Border VerticalOptions="Center" StrokeShape="RoundRectangle 16" BackgroundColor="White" Padding="20">
                <ScrollView HeightRequest="500">
                    <VerticalStackLayout Spacing="15">
                        <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                            <Label Text="Organize Event" FontSize="20" FontAttributes="Bold"/>
                            <ImageButton Source="close_black.png" WidthRequest="24" HeightRequest="24" Command="{Binding TogglePanelCommand}" CommandParameter="CloseOrganize" BackgroundColor="Transparent"/>
                        </Grid>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="ORGANIZER" FontSize="10" FontAttributes="Bold" TextColor="#777777"/>
                            <Entry Text="{Binding FormOrganizer}" IsReadOnly="True" BackgroundColor="#F2F4F7"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="5">
                            <Label Text="EMAIL" FontSize="10" FontAttributes="Bold" TextColor="#777777"/>
                            <Entry Text="{Binding FormEmail}" IsReadOnly="True" BackgroundColor="#F2F4F7"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="CATEGORY *" FontSize="10" FontAttributes="Bold"/>
                            <Picker Title="Select Category" ItemsSource="{Binding CategoriesList}" ItemDisplayBinding="{Binding CategoryName}" SelectedItem="{Binding SelectedCategory}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="EVENT TITLE *" FontSize="10" FontAttributes="Bold"/>
                            <Entry Text="{Binding FormTitle}" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="5">
                                <Label Text="VENUE NAME *" FontSize="10" FontAttributes="Bold"/>
                                <Entry Text="{Binding FormVenue}" Placeholder="e.g. Covered Court" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="5">
                                <Label Text="ADDRESS" FontSize="10" FontAttributes="Bold"/>
                                <Entry Text="{Binding FormAddress}" Placeholder="Complete address" />
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="5">
                                <Label Text="DATE *" FontSize="10" FontAttributes="Bold"/>
                                <DatePicker Date="{Binding FormDate}" Format="yyyy-MM-dd"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="5">
                                <Label Text="CAPACITY *" FontSize="10" FontAttributes="Bold"/>
                                <Entry Text="{Binding FormCapacity}" Keyboard="Numeric" Placeholder="e.g., 50"/>
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="5">
                                <Label Text="START TIME *" FontSize="10" FontAttributes="Bold"/>
                                <TimePicker Time="{Binding FormStartTime}" Format="HH:mm"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="5">
                                <Label Text="END TIME *" FontSize="10" FontAttributes="Bold"/>
                                <TimePicker Time="{Binding FormEndTime}" Format="HH:mm"/>
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="EVENT DESCRIPTION" FontSize="10" FontAttributes="Bold"/>
                            <Editor Text="{Binding FormDetails}" HeightRequest="80"/>
                        </VerticalStackLayout>

                        <Button Text="PUBLISH EVENT" Command="{Binding PublishEventCommand}" BackgroundColor="#00BAC7" TextColor="White" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>

        <Border Grid.Row="2" BackgroundColor="#FAD02C" StrokeShape="RoundRectangle 20,20,0,0" HeightRequest="60" Padding="0">
            <Grid ColumnDefinitions="*, *, *, *">
                <ImageButton Grid.Column="0" Source="home.png" Command="{Binding NavigateCommand}" CommandParameter="Home" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center" VerticalOptions="Center"/>
                <ImageButton Grid.Column="1" Source="proposals.png" Command="{Binding NavigateCommand}" CommandParameter="Proposals" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center" VerticalOptions="Center"/>
                <ImageButton Grid.Column="2" Source="events.png" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center" VerticalOptions="Center"/>
                <ImageButton Grid.Column="3" Source="profile.png" Command="{Binding NavigateCommand}" CommandParameter="Profile" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Grid>
        </Border>
    </Grid>
</ContentPage>