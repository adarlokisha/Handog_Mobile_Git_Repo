<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Handog_MobileApp.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="30,0" Spacing="25" VerticalOptions="Center">

            <Button x:Name="GoToVolunteerBtn"
                    Text="Volunteer" 
                    Clicked="VClick_Clicked"
                    HorizontalOptions="Fill"
                    BackgroundColor="Teal"/>

            <Button x:Name="GoToOrganizerBtn"
                    Text="Organizer" 
                    Clicked="OClick_Clicked"
                    HorizontalOptions="Fill" 
                    BackgroundColor="Yellow"
                    TextColor="Black"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>