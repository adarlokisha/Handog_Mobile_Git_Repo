<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Handog_MobileApp.V_PROPOSALS"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto, *, Auto" BackgroundColor="#F5F5F5">

        <Grid Grid.Row="0" BackgroundColor="#59CCD5" HeightRequest="60" Padding="15,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ImageButton Grid.Column="0" 
                         Source="back_black.png" 
                         HeightRequest="30" 
                         WidthRequest="30" 
                         HorizontalOptions="Start" 
                         VerticalOptions="Center"
                         Clicked="OnBackButtonClicked"/>

            <HorizontalStackLayout Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center">
                <Label Text="Hi, " FontSize="18" TextColor="Black" VerticalOptions="Center"/>
                <Label Text="Username!" FontAttributes="Bold" FontSize="18" TextColor="Black" VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Grid>

        <Grid Grid.Row="1">

            <Grid x:Name="ListViewContainer" IsVisible="True" BackgroundColor="White">
                <CollectionView x:Name="ProposalsCollectionView" Margin="20,0">
                    <CollectionView.Header>
                        <VerticalStackLayout Spacing="12" Padding="0,20,0,10">
                            <Image Source="proposals_black.png" HeightRequest="70" HorizontalOptions="Center" Margin="0,10"/>
                            <Label Text="EVENT PROPOSAL" FontAttributes="Bold" FontSize="26" HorizontalOptions="Center" TextColor="Black" CharacterSpacing="1.5"/>
                            <Label Text="Do you want to propose an event?" TextColor="#59CCD5" FontAttributes="Bold" FontSize="18"/>
                            <Label Text="These are the proposals currently sent by volunteers." TextColor="Gray" FontAttributes="Italic" FontSize="12" Margin="0,-5,0,5"/>
                            <BoxView HeightRequest="1" BackgroundColor="#D3D3D3"/>

                            <Border Margin="0,10,0,5" StrokeShape="RoundRectangle 20" StrokeThickness="0" BackgroundColor="#EFEFEF" Padding="2">
                                <Grid ColumnDefinitions="*, *, *">
                                    <Border x:Name="TabMyProposals" Grid.Column="0" StrokeShape="RoundRectangle 18" StrokeThickness="0" BackgroundColor="White">
                                        <Label Text="My Proposals" FontAttributes="Bold" FontSize="11" HorizontalOptions="Center" VerticalOptions="Center" Padding="0,8"/>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="MyProposalsTab_Tapped"/>
                                        </Border.GestureRecognizers>
                                    </Border>

                                    <Border x:Name="TabAllProposals" Grid.Column="1" StrokeShape="RoundRectangle 18" StrokeThickness="0" BackgroundColor="Transparent">
                                        <Label Text="All Proposals" FontSize="11" HorizontalOptions="Center" VerticalOptions="Center" Padding="0,8"/>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="AllProposalsTab_Tapped"/>
                                        </Border.GestureRecognizers>
                                    </Border>

                                    <Border x:Name="TabApprovedProposals" Grid.Column="2" StrokeShape="RoundRectangle 18" StrokeThickness="0" BackgroundColor="Transparent">
                                        <Label Text="Approved" FontSize="11" HorizontalOptions="Center" VerticalOptions="Center" Padding="0,8"/>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="ApprovedProposalsTab_Tapped"/>
                                        </Border.GestureRecognizers>
                                    </Border>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </CollectionView.Header>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="#F8F8F8" StrokeThickness="0" StrokeShape="RoundRectangle 15" Margin="0,8" Padding="15,12">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="{Binding RequestorName}" FontAttributes="Italic" TextColor="Gray" FontSize="12"/>
                                    <BoxView HeightRequest="1" BackgroundColor="#E0E0E0"/>
                                    <HorizontalStackLayout Spacing="4">
                                        <Label Text="TYPE OF REQUEST:" FontAttributes="Bold" TextColor="#4A4A4A" FontSize="14"/>
                                        <Label Text="{Binding RequestType}" FontAttributes="Bold" TextColor="#4A4A4A" FontSize="14"/>
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding Description}" TextColor="#555555" FontSize="13" LineBreakMode="WordWrap"/>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.Footer>
                        <BoxView HeightRequest="80" Color="White"/>
                    </CollectionView.Footer>
                </CollectionView>

                <Button Text="+ ADD PROPOSAL" 
                        BackgroundColor="#59CCD5" 
                        TextColor="White" 
                        FontAttributes="Bold"
                        FontSize="15"
                        CornerRadius="22"
                        HeightRequest="45"
                        WidthRequest="200"
                        HorizontalOptions="Center" 
                        VerticalOptions="End" 
                        Margin="0,0,0,20"
                        Clicked="OnAddProposalClicked"/>
            </Grid>

            <ScrollView x:Name="FormViewContainer" IsVisible="False" Padding="15,20">

                <Border BackgroundColor="#FDFDFD" Stroke="#C0C0C0" StrokeThickness="1.5" StrokeShape="RoundRectangle 20" Padding="20">

                    <VerticalStackLayout Spacing="15">

                        <Label Text="Event Proposal" FontAttributes="Bold" FontSize="24" TextColor="#707070" HorizontalOptions="Center"/>

                        <Label Text="Fill in the details below. MCGI Organizers will review and connect for you" TextColor="#707070" FontAttributes="Italic" FontSize="13" HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="0,0,0,5"/>

                        <BoxView HeightRequest="1" BackgroundColor="#D3D3D3" Margin="0,0,0,5"/>



                        <Label Text="Event Type" FontAttributes="Bold" TextColor="#707070" FontSize="14"/>

                        <Border Stroke="#C0C0C0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12,5" BackgroundColor="White">

                            <VerticalStackLayout Spacing="2">

                                <Label Text="What kind of event are you proposing?" TextColor="#888888" FontSize="12" FontAttributes="Bold"/>

                                <Picker x:Name="EventTypePicker" Title="Select type..." TextColor="Black" FontSize="14">

                                    <Picker.ItemsSource>

                                        <x:Array Type="{x:Type x:String}">

                                            <x:String>Medical Mission</x:String>

                                            <x:String>Feeding Program</x:String>

                                            <x:String>Youth Activity</x:String>

                                            <x:String>Spiritual Gathering</x:String>

                                            <x:String>Environmental Care</x:String>

                                        </x:Array>

                                    </Picker.ItemsSource>

                                </Picker>

                            </VerticalStackLayout>

                        </Border>



                        <Label Text="Event Details" FontAttributes="Bold" TextColor="#707070" FontSize="14" Margin="0,5,0,0"/>



                        <Border Stroke="#C0C0C0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12,6" BackgroundColor="White">

                            <VerticalStackLayout Spacing="2">

                                <Label Text="Title of the Proposed Event:" TextColor="#707070" FontAttributes="Bold" FontSize="12"/>

                                <Entry x:Name="EventTitleEntry" Placeholder="e.g. Medical Support Request: Senior Citizens Drive" TextColor="Black" FontSize="13" Margin="0,-4"/>

                            </VerticalStackLayout>

                        </Border>



                        <Border Stroke="#C0C0C0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12,6" BackgroundColor="White">

                            <VerticalStackLayout Spacing="2">

                                <Label Text="Brief Description of the Event" TextColor="#707070" FontAttributes="Bold" FontSize="12"/>

                                <Editor x:Name="EventDescriptionEditor" Placeholder="type here..." AutoSize="TextChanges" HeightRequest="60" TextColor="Black" FontSize="13" Margin="0,-4"/>

                            </VerticalStackLayout>

                        </Border>



                        <Border Stroke="#C0C0C0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12,6" BackgroundColor="White">

                            <VerticalStackLayout Spacing="2">

                                <Label Text="Estimated Number of Beneficiaries" TextColor="#707070" FontAttributes="Bold" FontSize="12"/>

                                <Entry x:Name="BeneficiariesEntry" Placeholder="type here..." Keyboard="Numeric" TextColor="Black" FontSize="13" Margin="0,-4"/>

                            </VerticalStackLayout>

                        </Border>



                        <Label Text="Event Location" FontAttributes="Bold" TextColor="#707070" FontSize="14" Margin="0,5,0,0"/>

                        <Border Stroke="#C0C0C0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12,6" BackgroundColor="White">

                            <VerticalStackLayout Spacing="2">

                                <Label Text="Suggested Location" TextColor="#707070" FontAttributes="Bold" FontSize="12"/>

                                <Entry x:Name="LocationEntry" Placeholder="type here..." TextColor="Black" FontSize="13" Margin="0,-4"/>

                            </VerticalStackLayout>

                        </Border>



                        <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,15,0,5">

                            <Button Grid.Column="0" Text="SAVE DRAFT" BackgroundColor="#B0B0B0" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="45" Clicked="OnSaveDraftClicked"/>

                            <Button Grid.Column="1" Text="SUBMIT PROPOSAL" BackgroundColor="#59CCD5" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="45" Clicked="OnSubmitProposalClicked"/>

                        </Grid>

                    </VerticalStackLayout>

                </Border>

            </ScrollView>

        </Grid>

        <Border Grid.Row="2" BackgroundColor="#59CCD5" StrokeShape="RoundRectangle 20,20,0,0" HeightRequest="65" StrokeThickness="0">
            <Grid ColumnDefinitions="*, *, *, *">
                <ImageButton Grid.Column="0" Source="home.png" Clicked="HomeBtn_Clicked" HorizontalOptions="Center" VerticalOptions="Center" HeightRequest="24" WidthRequest="24" BackgroundColor="Transparent"/>
                <ImageButton Grid.Column="1" Source="proposals.png" HorizontalOptions="Center" VerticalOptions="Center" HeightRequest="28" WidthRequest="28" BackgroundColor="Transparent"/>
                
            </Grid>
        </Border>

    </Grid>
</ContentPage>