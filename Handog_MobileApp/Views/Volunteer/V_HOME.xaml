<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Handog_MobileApp.ViewModels"
             xmlns:models="clr-namespace:Handog_MobileApp.Models"
             x:Class="Handog_MobileApp.V_HOME"
             BackgroundColor="#F4F6F8"
             NavigationPage.HasNavigationBar="False"
             x:DataType="viewmodels:V_HomeViewModel">

    <Grid>
        <Grid RowDefinitions="*, Auto">
            <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="16" Padding="0,0,0,24">

                    <!-- Welcome Header Area -->
                    <Border BackgroundColor="#00BAC7" 
                    StrokeShape="RoundRectangle 0,0,24,24" 
                    StrokeThickness="0" 
                    Padding="0" 
                    Margin="0">

                        <!-- Added Shadow as per original request -->
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,4" Radius="12" Opacity="0.1"/>
                        </Border.Shadow>

                        <Grid RowDefinitions="Auto" 
                      ColumnDefinitions="*, Auto" 
                      Padding="20, 48, 20, 24">

                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                <Label Text="Welcome back," 
                               TextColor="Black" 
                               FontSize="14" 
                               Opacity="0.8"/>
                                <Label Text="{Binding WelcomeName, StringFormat='{0}!'}" 
                               TextColor="Black" 
                               FontSize="24" 
                               FontAttributes="Bold" 
                               Margin="0,2,0,0"/>
                            </VerticalStackLayout>

                            <!-- Notification Bell Container -->
                            <Grid Grid.Column="1" VerticalOptions="Center" WidthRequest="34" HeightRequest="34">
                                <ImageButton Source="bell_black.png" 
                                     WidthRequest="26" HeightRequest="26" 
                                     HorizontalOptions="Center" VerticalOptions="Center" 
                                     Command="{Binding ViewNotificationsCommand}" 
                                     BackgroundColor="Transparent"/>
                                <Ellipse Fill="#FF4444" 
                                 WidthRequest="10" HeightRequest="10" 
                                 HorizontalOptions="End" VerticalOptions="Start" 
                                 Margin="0,2,2,0" 
                                 IsVisible="{Binding HasUnreadNotifications}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Core Banner Element Card -->
                    <Grid HeightRequest="210" Margin="0,4,0,0">
                        <Image Source="o_greetingcard.png" Aspect="AspectFill"/>
                        <BoxView BackgroundColor="White" Opacity="0.12"/>

                        <VerticalStackLayout Padding="20" VerticalOptions="Center" Spacing="6">
                            <Label Text="CONNECTING HEARTS&#10;AND STRENGTHENING&#10;COMMUNITIES" 
                                   TextColor="#1A1A1A" 
                                   FontAttributes="Bold" 
                                   FontSize="18" 
                                   LineHeight="1.15"/>
                            <Label Text="Start bridging the gap by joining an initiative; volunteer now!" 
                                   TextColor="#444444" 
                                   FontSize="12" 
                                   Margin="0,2,40,12"/>
                            <Button x:Name="JoinEventBtn"
                                    Text="+ JOIN EVENT" 
                                    BackgroundColor="#00BAC7" 
                                    TextColor="White" 
                                    FontAttributes="Bold" 
                                    HeightRequest="38"
                                    HorizontalOptions="Start"
                                    Padding="16,0"
                                    FontSize="12"
                                    Command="{Binding NavigateToEventsCommand}"
                                    CommandParameter="{x:Reference JoinEventBtn}"/>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Metrics Analytics Card -->
                    <Border Margin="16,4,16,0" StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="White">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,2" Radius="6" Opacity="0.04"/>
                        </Border.Shadow>

                        <Grid ColumnDefinitions="*, Auto" Padding="16" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="4">
                                <Label Text="PARTICIPATION RATE" 
                                       TextColor="#1A1A1A" 
                                       FontAttributes="Bold" 
                                       FontSize="15"/>
                                <Label Text="{Binding ParticipationText}" 
                                       TextColor="#777777" 
                                       FontSize="12"/>
                            </VerticalStackLayout>

                            <Grid Grid.Column="1" WidthRequest="64" HeightRequest="64" HorizontalOptions="End">
                                <Ellipse Stroke="#F0F2F5" StrokeThickness="6" WidthRequest="60" HeightRequest="60"/>
                                <Ellipse Stroke="#FAD02C" StrokeThickness="6" StrokeDashArray="10, 2" WidthRequest="60" HeightRequest="60"/>
                                <Label Text="{Binding ParticipationPercentage}" 
                                       TextColor="#1A1A1A" 
                                       FontAttributes="Bold" 
                                       FontSize="14" 
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Center"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Info About Platform Content Section Card -->
                    <Border Margin="16,4,16,0" StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="White">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,2" Radius="6" Opacity="0.04"/>
                        </Border.Shadow>

                        <VerticalStackLayout Padding="20" HorizontalOptions="Center" Spacing="14">
                            <Label Text="OUR STORY" 
                                   TextColor="#E0B513" 
                                   FontAttributes="Bold" 
                                   FontSize="12" 
                                   HorizontalOptions="Center"
                                   CharacterSpacing="1"/>
                            <Image Source="logo_teal.png" 
                                   WidthRequest="240" 
                                   Aspect="AspectFit"
                                   HorizontalOptions="Center" 
                                   Margin="0,2"/>
                            <Label Text="Our platform was created with one simple goal — to make community engagement easier, more organized, and more accessible for everyone. We saw the gap between people who want to serve, those who need support, and organizers who are willing to lead initiatives, but lack a centralized system to connect them all." 
                                   TextColor="#555555" 
                                   FontSize="13" 
                                   HorizontalTextAlignment="Center" 
                                   LineHeight="1.45"/>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>

            <!-- Navigation Tab Bar Layer Stack Layout -->
            <Border Grid.Row="1" 
                    BackgroundColor="#00BAC7" 
                    StrokeShape="RoundRectangle 35" 
                    StrokeThickness="0" 
                    HeightRequest="70" 
                    Margin="20, 0, 20, 25" 
                    VerticalOptions="End"
                    Padding="12, 0">

                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,4" Radius="10" Opacity="0.15"/>
                </Border.Shadow>

                <Grid ColumnDefinitions="*, *, *, *">
                    <ImageButton x:Name="HomeBtn" Grid.Column="0" Source="home.png" 
                     Command="{Binding NavigateToHomeCommand}" CommandParameter="{x:Reference HomeBtn}" 
                     HorizontalOptions="Center" VerticalOptions="Center" 
                     HeightRequest="24" WidthRequest="24" BackgroundColor="Transparent"/>

                    <ImageButton x:Name="ProposalsBtn" Grid.Column="1" Source="proposals.png" 
                     Command="{Binding NavigateToProposalsCommand}" CommandParameter="{x:Reference ProposalsBtn}" 
                     HorizontalOptions="Center" VerticalOptions="Center" 
                     HeightRequest="24" WidthRequest="24" BackgroundColor="Transparent"/>

                    <ImageButton x:Name="EventsBtn" Grid.Column="2" Source="events.png" 
                     Command="{Binding NavigateToEventsCommand}" CommandParameter="{x:Reference EventsBtn}" 
                     HorizontalOptions="Center" VerticalOptions="Center" 
                     HeightRequest="28" WidthRequest="28" BackgroundColor="Transparent"/>

                    <ImageButton x:Name="ProfileBtn" Grid.Column="3" Source="profile.png" 
                     Command="{Binding NavigateToProfileCommand}" CommandParameter="{x:Reference ProfileBtn}" 
                     HorizontalOptions="Center" VerticalOptions="Center" 
                     HeightRequest="28" WidthRequest="28" BackgroundColor="Transparent"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Tap-Away Background Dropdown Panel Toggle Overlay Closer -->
        <BoxView BackgroundColor="Transparent" IsVisible="{Binding IsNotificationPanelVisible}">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ViewNotificationsCommand}"/>
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- Reusable Notification Popout Overlay Card Window Layout -->
        <Border BackgroundColor="White" 
                StrokeShape="RoundRectangle 12" 
                StrokeThickness="0" 
                WidthRequest="320" 
                MaximumHeightRequest="400" 
                HorizontalOptions="End" 
                VerticalOptions="Start" 
                Margin="0, 80, 16, 0" 
                IsVisible="{Binding IsNotificationPanelVisible}">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,6" Radius="12" Opacity="0.15"/>
            </Border.Shadow>

            <Grid RowDefinitions="Auto, *">
                <Label Grid.Row="0" Text="Notifications" FontAttributes="Bold" FontSize="14" TextColor="#1A1A1A" Padding="16,12" BackgroundColor="#F4F6F8" />
                <BoxView Grid.Row="0" HeightRequest="1" Color="#EAEAEA" VerticalOptions="End"/>

                <CollectionView Grid.Row="1" ItemsSource="{Binding Notifications}">
                    <CollectionView.EmptyView>
                        <Label Text="No new notifications" TextColor="#777777" FontSize="12" HorizontalOptions="Center" Margin="0,30"/>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <!-- Pointed directly to the centralized NotificationModel -->
                        <DataTemplate x:DataType="models:NotificationModel">
                            <ContentView>
                                <ContentView.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding BindingContext.NotificationTappedCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" CommandParameter="{Binding .}"/>
                                </ContentView.GestureRecognizers>

                                <Grid RowDefinitions="Auto, Auto, Auto" Padding="16,12" BackgroundColor="{Binding BgColor}">
                                    <Label Grid.Row="0" Text="{Binding Title}" FontAttributes="{Binding TitleFont}" TextColor="#1A1A1A" FontSize="13"/>
                                    <Label Grid.Row="1" Text="{Binding Message}" TextColor="#555555" FontSize="11" Margin="0,2,0,0" LineBreakMode="WordWrap"/>
                                    <BoxView Grid.Row="2" HeightRequest="1" Color="#F0F2F5" Margin="-16,12,-16,-12" VerticalOptions="End"/>
                                </Grid>
                            </ContentView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>
    </Grid>
</ContentPage>