<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Handog_MobileApp.V_PROPOSALS"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto, *, Auto" BackgroundColor="#F5F5F5">

        <!-- Top Navigation Header -->
        <Grid Grid.Row="0" BackgroundColor="#59CCD5" HeightRequest="60" Padding="15,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ImageButton Grid.Column="0" 
                         Source="back_black.png" 
                         HeightRequest="30" 
                         WidthRequest="30" 
                         HorizontalOptions="Start" 
                         VerticalOptions="Center"
                         Clicked="OnBackButtonClicked"/>

            <HorizontalStackLayout Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center">
                <Label Text="Hi, " FontSize="18" TextColor="Black" VerticalOptions="Center"/>
                <Label Text="Username!" FontAttributes="Bold" FontSize="18" TextColor="Black" VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Grid>

        <!-- Main Body Content Area -->
        <Grid Grid.Row="1">

            <!-- Proposals List Container View -->
            <Grid IsVisible="{Binding IsListViewVisible}" BackgroundColor="White">
                <CollectionView ItemsSource="{Binding Proposals}" Margin="20,0">
                    <CollectionView.Header>
                        <VerticalStackLayout Spacing="12" Padding="0,20,0,10">
                            <Image Source="proposals_black.png" HeightRequest="60" WidthRequest="60" HorizontalOptions="Center" />
                            <Label Text="PROPOSALS" TextColor="#1A1A1A" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" CharacterSpacing="1.5"/>
                            <Label Text="Do you want to propose an event?" TextColor="#59CCD5" FontAttributes="Bold" FontSize="18"/>
                            <Label Text="These are the proposals currently sent by volunteers." TextColor="Gray" FontAttributes="Italic" FontSize="12" Margin="0,-5,0,5"/>
                            <BoxView HeightRequest="1" BackgroundColor="#D3D3D3"/>

                            <Border Margin="0,10,0,5" StrokeShape="RoundRectangle 20" StrokeThickness="0" BackgroundColor="#EFEFEF" Padding="2">
                                <Grid ColumnDefinitions="*, *, *">
                                    <Border x:Name="TabMyProposals" Grid.Column="0" StrokeShape="RoundRectangle 18" StrokeThickness="0" BackgroundColor="White">
                                        <Label Text="My Proposals" FontAttributes="Bold" FontSize="11" HorizontalOptions="Center" VerticalOptions="Center" Padding="0,8"/>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="MyProposalsTab_Tapped"/>
                                        </Border.GestureRecognizers>
                                    </Border>

                                    <Border x:Name="TabAllProposals" Grid.Column="1" StrokeShape="RoundRectangle 18" StrokeThickness="0" BackgroundColor="Transparent">
                                        <Label Text="All Proposals" FontSize="11" HorizontalOptions="Center" VerticalOptions="Center" Padding="0,8"/>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="AllProposalsTab_Tapped"/>
                                        </Border.GestureRecognizers>
                                    </Border>

                                    <Border x:Name="TabApprovedProposals" Grid.Column="2" StrokeShape="RoundRectangle 18" StrokeThickness="0" BackgroundColor="Transparent">
                                        <Label Text="Approved" FontSize="11" HorizontalOptions="Center" VerticalOptions="Center" Padding="0,8"/>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="ApprovedProposalsTab_Tapped"/>
                                        </Border.GestureRecognizers>
                                    </Border>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </CollectionView.Header>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="#F8F8F8" StrokeThickness="0" StrokeShape="RoundRectangle 15" Margin="0,8" Padding="15,12">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="{Binding RequestorName}" FontAttributes="Italic" TextColor="Gray" FontSize="12"/>
                                    <BoxView HeightRequest="1" BackgroundColor="#E0E0E0"/>
                                    <HorizontalStackLayout Spacing="4">
                                        <Label Text="TYPE OF REQUEST:" FontAttributes="Bold" TextColor="#4A4A4A" FontSize="14"/>
                                        <Label Text="{Binding RequestType}" FontAttributes="Bold" TextColor="#4A4A4A" FontSize="14"/>
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding Description}" TextColor="#555555" FontSize="13" LineBreakMode="WordWrap"/>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.Footer>
                        <BoxView HeightRequest="80" Color="White"/>
                    </CollectionView.Footer>
                </CollectionView>

                <Button Text="+ ADD PROPOSAL" 
                        BackgroundColor="#59CCD5" 
                        TextColor="White" 
                        FontAttributes="Bold"
                        FontSize="15"
                        CornerRadius="22"
                        HeightRequest="45"
                        WidthRequest="200"
                        HorizontalOptions="Center" 
                        VerticalOptions="End" 
                        Margin="0,0,0,20"
                        Command="{Binding ShowAddFormCommand}"/>
            </Grid>

            <!-- Modified Proposal Input Form View Container -->
            <ScrollView IsVisible="{Binding IsFormViewVisible}" Padding="15,20">
                <Border BackgroundColor="#FDFDFD" Stroke="#C0C0C0" StrokeThickness="1.5" StrokeShape="RoundRectangle 20" Padding="20">
                    <VerticalStackLayout Spacing="15">
                        <Label Text="Event Proposal" FontAttributes="Bold" FontSize="24" TextColor="#707070" HorizontalOptions="Center"/>
                        <Label Text="Fill in the details below. MCGI Organizers will review and connect for you" TextColor="#707070" FontAttributes="Italic" FontSize="13" HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="0,0,0,5"/>
                        <BoxView HeightRequest="1" BackgroundColor="#D3D3D3" Margin="0,0,0,5"/>

                        <!-- Category Selection -->
                        <Label Text="Category *" FontAttributes="Bold" TextColor="#707070" FontSize="14"/>
                        <Border Stroke="#C0C0C0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12,5" BackgroundColor="White">
                            <VerticalStackLayout Spacing="2">
                               
                                <Picker SelectedItem="{Binding SelectedCategory}" Title="Select Event Category..." TextColor="Black" FontSize="14">
                                    <Picker.ItemsSource>
                                        <x:Array Type="{x:Type x:String}">
                                            <x:String>Medical Mission</x:String>
                                            <x:String>Feeding Program</x:String>
                                            <x:String>Youth Activity</x:String>
                                            <x:String>Spiritual Gathering</x:String>
                                            <x:String>Environmental Care</x:String>
                                        </x:Array>
                                    </Picker.ItemsSource>
                                </Picker>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Event Title Entry -->
                        <Label Text="Title of Proposed Event *" FontAttributes="Bold" TextColor="#707070" FontSize="14" Margin="0,5,0,0"/>
                        <Border Stroke="#C0C0C0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12,6" BackgroundColor="White">
                            <VerticalStackLayout Spacing="2">
                                <Entry Text="{Binding ProposalTitle}" Placeholder="e.g. Community Health and Wellness Drive" TextColor="Black" FontAttributes="Italic" FontSize="13" Margin="0,-4"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Preferred Date Picker -->
                        <Label Text="Preferred Date *" FontAttributes="Bold" TextColor="#707070" FontSize="14" Margin="0,5,0,0"/>
                        <Border Stroke="#C0C0C0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12,6" BackgroundColor="White">
                            <VerticalStackLayout Spacing="2">
                                <DatePicker Date="{Binding PreferredDate}" TextColor="Black" FontSize="13" Margin="0,-4"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Grid Layout for Split Start and End Times -->
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,5,0,0">
                            <!-- Preferred Start Time -->
                            <VerticalStackLayout Grid.Column="0" Spacing="5">
                                <Label Text="Start Time *" FontAttributes="Bold" TextColor="#707070" FontSize="14"/>
                                <Border Stroke="#C0C0C0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12,6" BackgroundColor="White">
                                    <VerticalStackLayout Spacing="2">
                                        <TimePicker Time="{Binding PreferredStartTime}" TextColor="Black" FontSize="13" Margin="0,-4"/>
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Preferred End Time -->
                            <VerticalStackLayout Grid.Column="1" Spacing="5">
                                <Label Text="End Time *" FontAttributes="Bold" TextColor="#707070" FontSize="14"/>
                                <Border Stroke="#C0C0C0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12,6" BackgroundColor="White">
                                    <VerticalStackLayout Spacing="2">
                                        <TimePicker Time="{Binding PreferredEndTime}" TextColor="Black" FontSize="13" Margin="0,-4"/>
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Proposal Details Editor Area -->
                        <Label Text="Event Details" FontAttributes="Bold" TextColor="#707070" FontSize="14" Margin="0,5,0,0"/>
                        <Border Stroke="#C0C0C0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12,6" BackgroundColor="White">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Brief Description / Details of the Event" TextColor="#707070" FontAttributes="Bold" FontSize="12"/>
                                <Editor Text="{Binding ProposalDetails}" 
                                        Placeholder="e.g. Provide free health consultations, check-ups, 
                                        and distribution of basic medicines to residents in Cabuyao." 
                                        AutoSize="TextChanges" HeightRequest="80" TextColor="Black" FontAttributes="Italic" FontSize="13" Margin="0,-4"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Action Control Buttons Grid -->
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,15,0,5">
                            <Button Grid.Column="0" Text="SAVE DRAFT" BackgroundColor="#B0B0B0" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="45" Command="{Binding SaveDraftCommand}"/>
                            <Button Grid.Column="1" Text="SUBMIT PROPOSAL" BackgroundColor="#59CCD5" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="45" Command="{Binding SubmitProposalCommand}"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </ScrollView>
        </Grid>

        <!-- Bottom Tab Navigation Bar Container -->
        <Border Grid.Row="2" 
            BackgroundColor="#00BAC7" 
            StrokeShape="RoundRectangle 20,20,0,0" 
            StrokeThickness="0" 
            HeightRequest="60"
            Padding="12, 0">
            <Grid ColumnDefinitions="*, *, *, *">

                <ImageButton x:Name="HomeBtn"
                             Grid.Column="0" 
                             Source="home.png" 
                             Command="{Binding NavigateToHomeCommand}"
                             CommandParameter="{x:Reference HomeBtn}"        
                             HorizontalOptions="Center" 
                             VerticalOptions="Center"
                             HeightRequest="24" WidthRequest="24"
                             BackgroundColor="Transparent"/>

                <ImageButton x:Name="ProposalsBtn"
                     Grid.Column="1" 
                     Source="proposals.png" 
                     Command="{Binding NavigateToProposalsCommand}"
                     CommandParameter="{x:Reference ProposalsBtn}"
                     HorizontalOptions="Center" 
                     VerticalOptions="Center"
                     HeightRequest="24" WidthRequest="24"
                     BackgroundColor="Transparent"/>

                <ImageButton x:Name="EventsBtn"
             Grid.Column="2" 
             Source="events.png" 
             Command="{Binding NavigateToEventsCommand}"
             CommandParameter="{x:Reference EventsBtn}"
             HorizontalOptions="Center"
             VerticalOptions="Center"
             HeightRequest="28" WidthRequest="28"
             BackgroundColor="Transparent"/>


                <ImageButton x:Name="ProfileBtn"
             Grid.Column="3" 
             Source="profile.png" 
             Command="{Binding NavigateToProfileCommand}"
             CommandParameter="{x:Reference EventsBtn}"
             HorizontalOptions="Center"
             VerticalOptions="Center"
             HeightRequest="28" WidthRequest="28"
             BackgroundColor="Transparent"/>

            </Grid>
        </Border>

    </Grid>
</ContentPage>