<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Handog_MobileApp.ViewModels.Volunteer"
             x:Class="Handog_MobileApp.Views.Volunteer.V_PROFILE"
             x:DataType="viewmodels:V_ProfileViewModel"
             BackgroundColor="#F4F6F8"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- UPDATED HEADER: Matches O_PROFILE structure -->
        <Grid Grid.Row="0" BackgroundColor="#00BAC7" Padding="20, 50, 20, 15" ColumnDefinitions="*, Auto" IgnoreSafeArea="True">
            <HorizontalStackLayout Grid.Column="0" Spacing="5" VerticalOptions="Center">
                <Label Text="Hi," FontSize="20" TextColor="#1A1A1A" VerticalOptions="Center"/>
                <Label Text="{Binding HeaderUsername, StringFormat='{0}'}" FontSize="20" FontAttributes="Bold" TextColor="#1A1A1A" VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <!-- UPDATED PADDING: Matches O_PROFILE to prevent overlap with bottom nav -->
            <VerticalStackLayout Spacing="16" Padding="20, 20, 20, 100">

                <!-- UPDATED PROFILE ICON: Moved inside ScrollView, size adjusted to 60x60 -->
                <VerticalStackLayout Spacing="5" Margin="0, 0, 0, 10">
                    <Image Source="profile_black.png" HeightRequest="60" WidthRequest="60" HorizontalOptions="Center" />
                    <Label Text="PROFILE" TextColor="#1A1A1A" FontSize="26" FontAttributes="Bold" HorizontalOptions="Center" CharacterSpacing="1.5"/>
                </VerticalStackLayout>

                <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="White">
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,2" Radius="6" Opacity="0.04"/>
                    </Border.Shadow>

                    <Grid ColumnDefinitions="Auto, *" Padding="20" VerticalOptions="Center" ColumnSpacing="16">

                        <Border Grid.Column="0"
                                Stroke="#4DD0E1" 
                                StrokeThickness="2" 
                                HeightRequest="70" 
                                WidthRequest="70" 
                                HorizontalOptions="Center" 
                                VerticalOptions="Center"
                                StrokeShape="RoundRectangle 35" 
                                BackgroundColor="#F9F9F9">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnProfileImageTapped" />
                            </Border.GestureRecognizers>

                            <Grid>
                                <Label Text="+" 
                                       TextColor="#4DD0E1" 
                                       FontSize="35" 
                                       FontAttributes="Bold" 
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Center" 
                                       Margin="0,-4,0,0"
                                       IsVisible="{Binding HasNoProfileImage}" />

                                <Image Source="{Binding ProfileImageUrl}" 
                                       Aspect="AspectFill" 
                                       IsVisible="{Binding HasProfileImage}" />
                            </Grid>
                        </Border>

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="{Binding FullName}" TextColor="#1A1A1A" FontAttributes="Bold" FontSize="18"/>
                            <Label Text="{Binding AccountId}" TextColor="#777777" FontSize="12" FontAttributes="Italic"/>
                            <BoxView HeightRequest="1" BackgroundColor="#F0F2F5" Margin="0,6,0,4"/>
                            <Label Text="VOLUNTEER" TextColor="#4DD0E1" FontAttributes="Bold" FontSize="12" CharacterSpacing="1"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Events" TextColor="#777777" FontAttributes="Bold" FontSize="11" Margin="4,0,0,0"/>

                    <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="White">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,2" Radius="6" Opacity="0.04"/>
                        </Border.Shadow>

                        <Grid ColumnDefinitions="*, *, *" Padding="12,20">
                            <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="4">
                                <Label Text="{Binding CountCompleted}" TextColor="#4DD0E1" FontAttributes="Bold" FontSize="26" HorizontalOptions="Center"/>
                                <Label Text="Completed" TextColor="#1A1A1A" FontSize="12" HorizontalOptions="Center"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4">
                                <Label Text="{Binding CountJoined}" TextColor="#4DD0E1" FontAttributes="Bold" FontSize="26" HorizontalOptions="Center"/>
                                <Label Text="Joined" TextColor="#1A1A1A" FontSize="12" HorizontalOptions="Center"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="4">
                                <Label Text="{Binding CountAbsences}" TextColor="#D32F2F" FontAttributes="Bold" FontSize="26" HorizontalOptions="Center"/>
                                <Label Text="Absences" TextColor="#1A1A1A" FontSize="12" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="UNIQUE QR CODE" TextColor="#777777" FontAttributes="Bold" FontSize="11" Margin="4,0,0,0"/>

                    <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="White">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,2" Radius="6" Opacity="0.04"/>
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="12" Padding="24">
                            <Border x:Name="QrCodeContainer"
                                    HeightRequest="220" 
                                    WidthRequest="220" 
                                    StrokeThickness="0"
                                    BackgroundColor="#F9F9F9"
                                    StrokeShape="RoundRectangle 8"
                                    HorizontalOptions="Center" 
                                    VerticalOptions="Center">

                                <Image Source="{Binding QrCodeImageUrl}" Aspect="AspectFit" Margin="10"/>
                            </Border>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <Button Text="LOGOUT"
                        BackgroundColor="#D32F2F"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="12"
                        HeightRequest="36"
                        WidthRequest="140"
                        CornerRadius="18"
                        Padding="0"
                        Margin="0,12,0,0"
                        HorizontalOptions="Center"
                        Command="{Binding LogoutCommand}"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- UPDATED ROW: Changed from Grid.Row="5" to Grid.Row="2" -->
        <Border Grid.Row="2" 
                BackgroundColor="#00BAC7" 
                StrokeShape="RoundRectangle 35" 
                StrokeThickness="0" 
                HeightRequest="70" 
                Margin="20, 0, 20, 25" 
                VerticalOptions="End"
                Padding="12, 0">

            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,4" Radius="10" Opacity="0.15"/>
            </Border.Shadow>

            <Grid ColumnDefinitions="*, *, *, *">
                <ImageButton x:Name="HomeBtn" Grid.Column="0" Source="home.png" 
                             Command="{Binding NavigateToHomeCommand}" CommandParameter="{x:Reference HomeBtn}" 
                             HorizontalOptions="Center" VerticalOptions="Center" 
                             HeightRequest="24" WidthRequest="24" BackgroundColor="Transparent"/>

                <ImageButton x:Name="ProposalsBtn" Grid.Column="1" Source="proposals.png" 
                             Command="{Binding NavigateToProposalsCommand}" CommandParameter="{x:Reference ProposalsBtn}" 
                             HorizontalOptions="Center" VerticalOptions="Center" 
                             HeightRequest="24" WidthRequest="24" BackgroundColor="Transparent"/>

                <ImageButton x:Name="EventsBtn" Grid.Column="2" Source="events.png" 
                             Command="{Binding NavigateToEventsCommand}" CommandParameter="{x:Reference EventsBtn}" 
                             HorizontalOptions="Center" VerticalOptions="Center" 
                             HeightRequest="28" WidthRequest="28" BackgroundColor="Transparent"/>

                <ImageButton x:Name="ProfileBtn" Grid.Column="3" Source="profile.png" 
                             Command="{Binding NavigateToProfileCommand}" CommandParameter="{x:Reference ProfileBtn}" 
                             HorizontalOptions="Center" VerticalOptions="Center" 
                             HeightRequest="38" WidthRequest="38" BackgroundColor="Transparent"/>
            </Grid>
        </Border>

    </Grid>
</ContentPage>