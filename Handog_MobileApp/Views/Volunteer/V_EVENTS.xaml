<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Handog_MobileApp.ViewModels.Volunteer"
             xmlns:models="clr-namespace:Handog_MobileApp.Models"
             x:Class="Handog_MobileApp.Views.Volunteer.V_EVENTS"
             x:Name="thisPage"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto, Auto, Auto, *, Auto" BackgroundColor="#F5F5F5">

        <!-- Top Header Navigation -->
        <Grid Grid.Row="0" BackgroundColor="#00BAC7" Padding="20, 50, 20, 15" ColumnDefinitions="*, Auto" IgnoreSafeArea="True">
            <HorizontalStackLayout Grid.Column="0" Spacing="5" VerticalOptions="Center">
                <Label Text="Hi," FontSize="20" TextColor="#1A1A1A" VerticalOptions="Center"/>
                <Label Text="{Binding VolunteerNameHeader}" FontSize="20" FontAttributes="Bold" TextColor="#1A1A1A" VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Grid>

    <!-- Dynamic Page Brand Indicator -->
        <VerticalStackLayout Grid.Row="1" HorizontalOptions="Center" Spacing="5" Padding="0,20,0,10">
            <Image Source="events_black.png" HeightRequest="44" WidthRequest="44" HorizontalOptions="Center" />
            <Label Text="EVENTS" TextColor="#1A1A1A" FontAttributes="Bold" FontSize="26" CharacterSpacing="1" HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <!-- Filters Section Container -->
        <VerticalStackLayout Grid.Row="2" Padding="20,0" Spacing="15">
            <Border StrokeShape="RoundRectangle 22" StrokeThickness="0" BackgroundColor="White" HeightRequest="44" WidthRequest="350" Margin="0,8,0,0">
                <SearchBar Text="{Binding SearchQuery}" Placeholder="Search events..." TextColor="#1A1A1A" BackgroundColor="Transparent"/>
            </Border>

            <Border Margin="0,5,0,5" StrokeShape="RoundRectangle 20" StrokeThickness="0" BackgroundColor="#EFEFEF" Padding="2">
                <Grid ColumnDefinitions="*, *">
                    <Border x:Name="TabMyEvents" Grid.Column="0" StrokeShape="RoundRectangle 18" StrokeThickness="0" BackgroundColor="Transparent">
                        <Label Text="My Events" FontAttributes="Bold" FontSize="11" TextColor="Black" HorizontalOptions="Center" VerticalOptions="Center" Padding="0,8"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="MyEventsTab_Tapped"/>
                        </Border.GestureRecognizers>
                    </Border>

                    <Border x:Name="TabAllEvents" Grid.Column="1" StrokeShape="RoundRectangle 18" StrokeThickness="0" BackgroundColor="#4DD0E1">
                        <Label Text="All Events" FontSize="11" TextColor="Black" HorizontalOptions="Center" VerticalOptions="Center" Padding="0,8"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="AllEventsTab_Tapped"/>
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>
            </Border>
        </VerticalStackLayout>

        <!-- Intersecting Component Body Container Layer -->
        <Grid Grid.Row="3" Margin="20,15,20,0">

            <!-- VIEW COMPONENT A: Events Collection List Layout View -->
            <CollectionView IsVisible="{Binding IsListViewVisible}" ItemsSource="{Binding DisplayedEvents}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:EventModel">
                        <Border StrokeShape="RoundRectangle 15" StrokeThickness="0" BackgroundColor="#F8F8F8" Margin="0,0,0,12">

                            <Grid ColumnDefinitions="*, *">

                                <Grid Grid.Column="0" RowDefinitions="Auto, Auto, Auto" Padding="12" RowSpacing="2" VerticalOptions="Center">

                                    <Label Grid.Row="0" Text="{Binding EventTitle}" FontAttributes="Bold" FontSize="15" TextColor="#1A1A1A" TextDecorations="Underline" LineBreakMode="WordWrap"/>

                                    <VerticalStackLayout Grid.Row="1" Spacing="2" Margin="0,4">
                                        <Label Text="{Binding EventVenue, StringFormat='• {0}'}" TextColor="#777777" FontSize="11" LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding EventDate, StringFormat='• {0}'}" TextColor="#777777" FontSize="11"/>
                                        <Label Text="{Binding EventTime, StringFormat='• {0}'}" TextColor="#777777" FontSize="11"/>
                                    </VerticalStackLayout>

                                    <Label Grid.Row="2" Text="{Binding EventDetails}" FontSize="11" TextColor="#777777" MaxLines="3" LineBreakMode="WordWrap"/>
                                </Grid>

                                <Grid Grid.Column="1" Padding="0">
                                    <Image Source="{Binding CategoryImage}" Aspect="AspectFill" />

                                    <Button Text="REGISTER" 
                                IsVisible="False"
                                BackgroundColor="#F4D03F" 
                                TextColor="Black" 
                                FontAttributes="Bold" 
                                FontSize="11" 
                                CornerRadius="16"
                                HeightRequest="36"
                                WidthRequest="110"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                Command="{Binding BindingContext.RegisterCommand, Source={x:Reference thisPage}}"
                                CommandParameter="{Binding .}">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding IsMyEvent}" Value="False">
                                                <Setter Property="IsVisible" Value="True"/>
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>

                                    <Button Text="VIEW DETAILS" 
                                IsVisible="False"
                                BackgroundColor="#F4D03F" 
                                TextColor="Black" 
                                FontAttributes="Bold" 
                                FontSize="11" 
                                CornerRadius="16"
                                HeightRequest="36"
                                WidthRequest="110"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                Command="{Binding BindingContext.ViewEventDetailsCommand, Source={x:Reference thisPage}}"
                                CommandParameter="{Binding .}">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding IsMyEvent}" Value="True">
                                                <Setter Property="IsVisible" Value="True"/>
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                </Grid>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- VIEW COMPONENT B: Inline Event Details Display Form Overlay Panel -->
            <ScrollView IsVisible="{Binding IsDetailsViewVisible}" Padding="5,0,5,15">
                <Border BackgroundColor="#FDFDFD" Stroke="#C0C0C0" StrokeThickness="1.5" StrokeShape="RoundRectangle 20" Padding="20">
                    <VerticalStackLayout Spacing="15">
                        <Label Text="{Binding SelectedEventTarget.EventTitle}" FontAttributes="Bold" FontSize="24" TextColor="Black" HorizontalOptions="Center"/>
                        <Label Text="{Binding SelectedEventTarget.OrganizerName, StringFormat='Organized by: {0}'}" TextColor="Gray" FontAttributes="Italic" FontSize="13" HorizontalOptions="Center"/>
                        <BoxView HeightRequest="1" BackgroundColor="#D3D3D3"/>

                        <Label Text="Schedule Details" FontAttributes="Bold" TextColor="#4A4A4A" FontSize="14"/>
                        <Label Text="{Binding SelectedEventTarget.EventDate, StringFormat='📅 Date: {0}'}" TextColor="Black" FontSize="14"/>
                        <Label Text="{Binding SelectedEventTarget.EventTime, StringFormat='⏰ Start Time: {0}'}" TextColor="Black" FontSize="14"/>

                        <Label Text="Venue Address" FontAttributes="Bold" TextColor="#4A4A4A" FontSize="14" Margin="0,5,0,0"/>
                        <Label Text="{Binding SelectedEventTarget.EventVenue}" TextColor="Black" FontAttributes="Bold" FontSize="14"/>
                        <Label Text="{Binding SelectedEventTarget.EventAddress}" TextColor="Gray" FontSize="13"/>

                        <Label Text="Description" FontAttributes="Bold" TextColor="#4A4A4A" FontSize="14" Margin="0,5,0,0"/>
                        <Label Text="{Binding SelectedEventTarget.EventDetails}" TextColor="#555555" FontSize="14" LineBreakMode="WordWrap"/>

                        <BoxView HeightRequest="1" BackgroundColor="#D3D3D3" Margin="0,10,0,5"/>

                        <!-- REGISTER PANEL BUTTON -->
                        <Button Text="REGISTER FOR EVENT" 
                                BackgroundColor="#F4D03F" 
                                TextColor="Black" 
                                FontAttributes="Bold" 
                                CornerRadius="12" 
                                HeightRequest="45"
                                Command="{Binding RegisterCommand}"
                                CommandParameter="{Binding SelectedEventTarget}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding SelectedEventTarget.IsMyEvent}" Value="True">
                                    <Setter Property="IsVisible" Value="False"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Button" Binding="{Binding SelectedEventTarget.IsMyEvent}" Value="False">
                                    <Setter Property="IsVisible" Value="True"/>
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>

                        <!-- UNREGISTER PANEL BUTTON -->
                        <Button Text="CANCEL REGISTRATION (UNREGISTER)" 
                                BackgroundColor="#E74C3C" 
                                TextColor="White" 
                                FontAttributes="Bold" 
                                CornerRadius="12" 
                                HeightRequest="45"
                                Command="{Binding UnregisterCommand}"
                                CommandParameter="{Binding SelectedEventTarget}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding SelectedEventTarget.IsMyEvent}" Value="True">
                                    <Setter Property="IsVisible" Value="True"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Button" Binding="{Binding SelectedEventTarget.IsMyEvent}" Value="False">
                                    <Setter Property="IsVisible" Value="False"/>
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>

                        <Button Text="BACK TO EVENTS" 
                                BackgroundColor="#59CCD5" 
                                TextColor="White" 
                                FontAttributes="Bold" 
                                CornerRadius="12" 
                                HeightRequest="45" 
                                Margin="0,15,0,0"
                                Command="{Binding CloseDetailsCommand}"/>
                    </VerticalStackLayout>
                </Border>
            </ScrollView>
        </Grid>

        <!-- Bottom Tab Footer Layout Navigation Bar -->
        <Border Grid.Row="4" 
        BackgroundColor="#00BAC7" 
        StrokeShape="RoundRectangle 35" 
        StrokeThickness="0" 
        HeightRequest="70" 
        Margin="20, 0, 20, 25" 
        VerticalOptions="End"
        Padding="12, 0">

            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,4" Radius="10" Opacity="0.15"/>
            </Border.Shadow>

            <Grid ColumnDefinitions="*, *, *, *">
                <ImageButton x:Name="HomeBtn" Grid.Column="0" Source="home.png" 
         Command="{Binding NavigateToHomeCommand}" CommandParameter="{x:Reference HomeBtn}" 
         HorizontalOptions="Center" VerticalOptions="Center" 
         HeightRequest="24" WidthRequest="24" BackgroundColor="Transparent"/>

                <ImageButton x:Name="ProposalsBtn" Grid.Column="1" Source="proposals.png" 
         Command="{Binding NavigateToProposalsCommand}" CommandParameter="{x:Reference ProposalsBtn}" 
         HorizontalOptions="Center" VerticalOptions="Center" 
         HeightRequest="24" WidthRequest="24" BackgroundColor="Transparent"/>

                <ImageButton x:Name="EventsBtn" Grid.Column="2" Source="events.png" 
         Command="{Binding NavigateToEventsCommand}" CommandParameter="{x:Reference EventsBtn}" 
         HorizontalOptions="Center" VerticalOptions="Center" 
         HeightRequest="28" WidthRequest="28" BackgroundColor="Transparent"/>

                <ImageButton x:Name="ProfileBtn" Grid.Column="3" Source="profile.png" 
         Command="{Binding NavigateToProfileCommand}" CommandParameter="{x:Reference ProfileBtn}" 
         HorizontalOptions="Center" VerticalOptions="Center" 
         HeightRequest="28" WidthRequest="28" BackgroundColor="Transparent"/>
            </Grid>
        </Border>
    </Grid>
</ContentPage>