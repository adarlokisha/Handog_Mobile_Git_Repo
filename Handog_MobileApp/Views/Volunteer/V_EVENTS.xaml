<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Handog_MobileApp.ViewModels.Volunteer"
             x:Class="Handog_MobileApp.Views.Volunteer.V_EVENTS"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto, Auto, Auto, *, Auto" BackgroundColor="#F5F5F5">

        <!-- Top Header Navigation -->
        <Grid Grid.Row="0" BackgroundColor="#4DD0E1" Padding="15,10" ColumnDefinitions="Auto, *">
            <ImageButton Source="back_arrow.png" WidthRequest="25" HeightRequest="25" HorizontalOptions="Start"/>
            <Label Grid.Column="1" Text="Hi, Volunteer!" FontAttributes="Bold" FontSize="18" TextColor="Black" HorizontalOptions="End" VerticalOptions="Center"/>
        </Grid>

        <!-- Dynamic Page Brand Indicator -->
        <VerticalStackLayout Grid.Row="1" HorizontalOptions="Center" Spacing="5" Padding="0,20,0,10">
            <Image Source="calendar_icon.png" WidthRequest="70" HeightRequest="70"/>
            <Label Text="EVENTS" FontSize="32" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <!-- Filters Section Container -->
        <VerticalStackLayout Grid.Row="2" Padding="20,0" Spacing="15">
            <Border StrokeShape="RoundRectangle 20" StrokeThickness="1" Stroke="#E0E0E0" Padding="10,2" BackgroundColor="White">
                <Grid ColumnDefinitions="Auto, *">
                    <Image Source="search_icon.png" WidthRequest="18" HeightRequest="18" Margin="5,0"/>
                    <Entry Grid.Column="1" 
                           Placeholder="Search..." 
                           PlaceholderColor="Gray" 
                           TextColor="Black" 
                           FontSize="14"
                           Text="{Binding SearchQuery, Mode=TwoWay}"/>
                </Grid>
            </Border>

            <Border Margin="0,5,0,5" StrokeShape="RoundRectangle 20" StrokeThickness="0" BackgroundColor="#EFEFEF" Padding="2">
                <Grid ColumnDefinitions="*, *">
                    <Border x:Name="TabMyEvents" Grid.Column="0" StrokeShape="RoundRectangle 18" StrokeThickness="0" BackgroundColor="Transparent">
                        <Label Text="My Events" FontAttributes="Bold" FontSize="11" TextColor="Black" HorizontalOptions="Center" VerticalOptions="Center" Padding="0,8"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="MyEventsTab_Tapped"/>
                        </Border.GestureRecognizers>
                    </Border>

                    <Border x:Name="TabAllEvents" Grid.Column="1" StrokeShape="RoundRectangle 18" StrokeThickness="0" BackgroundColor="Transparent">
                        <Label Text="All Events" FontSize="11" TextColor="Black" HorizontalOptions="Center" VerticalOptions="Center" Padding="0,8"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="AllEventsTab_Tapped"/>
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>
            </Border>
        </VerticalStackLayout>

        <!-- Intersecting Component Body Container Layer -->
        <Grid Grid.Row="3" Margin="20,15,20,0">

            <!-- VIEW COMPONENT A: Events Collection List Layout View -->
            <CollectionView IsVisible="{Binding IsListViewVisible}" ItemsSource="{Binding DisplayedEvents}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <!-- FIXED: Removed the TapGestureRecognizer from here so clicking the box does nothing -->
                        <Border StrokeShape="RoundRectangle 15" StrokeThickness="0" BackgroundColor="#F8F8F8" Margin="0,0,0,12" HeightRequest="130">
                            <Grid ColumnDefinitions="*, 110">

                                <VerticalStackLayout Padding="12" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding EventTitle}" FontAttributes="Bold" FontSize="18" TextColor="Black"/>
                                    <Label Text="{Binding EventDate, StringFormat='• DATE: {0}'}" FontSize="10" TextColor="Gray"/>
                                    <Label Text="{Binding EventTime, StringFormat='• TIME: {0}'}" FontSize="10" TextColor="Gray"/>
                                    <Label Text="{Binding EventDetails}" FontSize="10" TextColor="Gray" MaxLines="2" LineBreakMode="TailTruncation"/>
                                </VerticalStackLayout>

                                <!-- Action Bar Block -->
                                <Grid Grid.Column="1">
                                    <BoxView BackgroundColor="#4DD0E1" Opacity="0.15"/>

                                    <!-- REGISTER: Only shows up if IsMyEvent is False -->
                                    <Button Text="REGISTER" 
                                            BackgroundColor="#F4D03F" 
                                            TextColor="Black" 
                                            FontAttributes="Bold" 
                                            FontSize="11" 
                                            CornerRadius="15"
                                            HeightRequest="32"
                                            WidthRequest="90"
                                            HorizontalOptions="Center" 
                                            VerticalOptions="Center"
                                            Command="{Binding BindingContext.RegisterCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                            CommandParameter="{Binding .}">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding IsMyEvent}" Value="True">
                                                <Setter Property="IsVisible" Value="False"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Button" Binding="{Binding IsMyEvent}" Value="False">
                                                <Setter Property="IsVisible" Value="True"/>
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>

                                    <!-- View Details button on My Events tab -->
                                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" 
                                                         Spacing="6" IsVisible="{Binding IsMyEvent}">
                                        
                                        <!-- NEW: VIEW DETAILS BUTTON -->
                                        <Button Text="DETAILS" 
                                                BackgroundColor="#59CCD5" 
                                                TextColor="White" 
                                                FontAttributes="Bold" 
                                                FontSize="10" 
                                                CornerRadius="15"
                                                HeightRequest="32"
                                                WidthRequest="95"
                                                Command="{Binding BindingContext.ViewEventDetailsCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                CommandParameter="{Binding .}"/>
                                    </VerticalStackLayout>

                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- VIEW COMPONENT B: Inline Event Details Display Form Overlay Panel -->
            <ScrollView IsVisible="{Binding IsDetailsViewVisible}" Padding="5,0,5,15">
                <Border BackgroundColor="#FDFDFD" Stroke="#C0C0C0" StrokeThickness="1.5" StrokeShape="RoundRectangle 20" Padding="20">
                    <VerticalStackLayout Spacing="15">
                        <Label Text="{Binding SelectedEventTarget.EventTitle}" FontAttributes="Bold" FontSize="24" TextColor="Black" HorizontalOptions="Center"/>
                        <Label Text="{Binding SelectedEventTarget.OrganizerName, StringFormat='Organized by: {0}'}" TextColor="Gray" FontAttributes="Italic" FontSize="13" HorizontalOptions="Center"/>
                        <BoxView HeightRequest="1" BackgroundColor="#D3D3D3"/>

                        <Label Text="Schedule Details" FontAttributes="Bold" TextColor="#4A4A4A" FontSize="14"/>
                        <Label Text="{Binding SelectedEventTarget.EventDate, StringFormat='📅 Date: {0}'}" TextColor="Black" FontSize="14"/>
                        <Label Text="{Binding SelectedEventTarget.EventTime, StringFormat='⏰ Start Time: {0}'}" TextColor="Black" FontSize="14"/>

                        <Label Text="Venue Address" FontAttributes="Bold" TextColor="#4A4A4A" FontSize="14" Margin="0,5,0,0"/>
                        <Label Text="{Binding SelectedEventTarget.EventVenue}" TextColor="Black" FontAttributes="Bold" FontSize="14"/>
                        <Label Text="{Binding SelectedEventTarget.EventAddress}" TextColor="Gray" FontSize="13"/>

                        <Label Text="Description" FontAttributes="Bold" TextColor="#4A4A4A" FontSize="14" Margin="0,5,0,0"/>
                        <Label Text="{Binding SelectedEventTarget.EventDetails}" TextColor="#555555" FontSize="14" LineBreakMode="WordWrap"/>

                        <BoxView HeightRequest="1" BackgroundColor="#D3D3D3" Margin="0,10,0,5"/>

                        <!-- REGISTER PANEL BUTTON -->
                        <Button Text="REGISTER FOR EVENT" 
                                BackgroundColor="#F4D03F" 
                                TextColor="Black" 
                                FontAttributes="Bold" 
                                CornerRadius="12" 
                                HeightRequest="45"
                                Command="{Binding RegisterCommand}"
                                CommandParameter="{Binding SelectedEventTarget}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding SelectedEventTarget.IsMyEvent}" Value="True">
                                    <Setter Property="IsVisible" Value="False"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Button" Binding="{Binding SelectedEventTarget.IsMyEvent}" Value="False">
                                    <Setter Property="IsVisible" Value="True"/>
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>

                        <!-- UNREGISTER PANEL BUTTON -->
                        <Button Text="CANCEL REGISTRATION (UNREGISTER)" 
                                BackgroundColor="#E74C3C" 
                                TextColor="White" 
                                FontAttributes="Bold" 
                                CornerRadius="12" 
                                HeightRequest="45"
                                Command="{Binding UnregisterCommand}"
                                CommandParameter="{Binding SelectedEventTarget}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding SelectedEventTarget.IsMyEvent}" Value="True">
                                    <Setter Property="IsVisible" Value="True"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Button" Binding="{Binding SelectedEventTarget.IsMyEvent}" Value="False">
                                    <Setter Property="IsVisible" Value="False"/>
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>

                        <Button Text="BACK TO EVENTS" 
                                BackgroundColor="#59CCD5" 
                                TextColor="White" 
                                FontAttributes="Bold" 
                                CornerRadius="12" 
                                HeightRequest="45" 
                                Margin="0,15,0,0"
                                Command="{Binding CloseDetailsCommand}"/>
                    </VerticalStackLayout>
                </Border>
            </ScrollView>
        </Grid>

        <!-- Bottom Tab Footer Layout Navigation Bar -->
        <Border Grid.Row="4" BackgroundColor="#4DD0E1" StrokeShape="RoundRectangle 25,25,0,0" Padding="20,10" HeightRequest="65" StrokeThickness="0">
            <Grid ColumnDefinitions="*, *, *, *">
                <ImageButton Grid.Column="0" Source="home.png" Command="{Binding NavigateToHomeCommand}" CommandParameter="{Binding Source={RelativeSource Self}}" HorizontalOptions="Center" VerticalOptions="Center" HeightRequest="24" WidthRequest="24" BackgroundColor="Transparent"/>
                <ImageButton Grid.Column="1" Source="proposals.png" Command="{Binding NavigateToProposalsCommand}" CommandParameter="{Binding Source={RelativeSource Self}}" HorizontalOptions="Center" VerticalOptions="Center" HeightRequest="28" WidthRequest="28" BackgroundColor="Transparent"/>
                <ImageButton Grid.Column="2" Source="events.png" HorizontalOptions="Center" VerticalOptions="Center" HeightRequest="26" WidthRequest="26" BackgroundColor="Transparent"/>
            </Grid>
        </Border>
    </Grid>
</ContentPage>