<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Handog_MobileApp.ViewModels.Volunteer"
             x:Class="Handog_MobileApp.Views.Volunteer.V_EVENTS"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto, Auto, Auto, *, Auto" BackgroundColor="#F5F5F5">

        <Grid Grid.Row="0" BackgroundColor="#4DD0E1" Padding="15,10" ColumnDefinitions="Auto, *">
            <ImageButton Source="back_arrow.png" WidthRequest="25" HeightRequest="25" HorizontalOptions="Start"/>
            <Label Grid.Column="1" Text="Hi, Username!" FontAttributes="Bold" FontSize="18" TextColor="Black" HorizontalOptions="End" VerticalOptions="Center"/>
        </Grid>

        <VerticalStackLayout Grid.Row="1" HorizontalOptions="Center" Spacing="5" Padding="0,20,0,10">
            <Image Source="calendar_icon.png" WidthRequest="70" HeightRequest="70"/>
            <Label Text="EVENTS" FontSize="32" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="2" Padding="20,0" Spacing="15">
            <Border StrokeShape="RoundRectangle 20" StrokeThickness="1" Stroke="#E0E0E0" Padding="10,2" BackgroundColor="White">
                <Grid ColumnDefinitions="Auto, *">
                    <Image Source="search_icon.png" WidthRequest="18" HeightRequest="18" Margin="5,0"/>
                    <Entry Grid.Column="1" Placeholder="Search..." PlaceholderColor="Gray" TextColor="Black" FontSize="14"/>
                </Grid>
            </Border>

            <Border Margin="0,5,0,5" StrokeShape="RoundRectangle 20" StrokeThickness="0" BackgroundColor="#EFEFEF" Padding="2">
                <Grid ColumnDefinitions="*, *">

                    <Border x:Name="TabMyEvents" Grid.Column="0" StrokeShape="RoundRectangle 18" StrokeThickness="0" BackgroundColor="#4DD0E1">
                        <Label Text="My Events" FontAttributes="Bold" FontSize="11" TextColor="Black" HorizontalOptions="Center" VerticalOptions="Center" Padding="0,8"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding FilterCommand}" CommandParameter="MyEvents" Tapped="MyEventsTab_Tapped"/>
                        </Border.GestureRecognizers>
                    </Border>

                    <Border x:Name="TabAllEvents" Grid.Column="1" StrokeShape="RoundRectangle 18" StrokeThickness="0" BackgroundColor="Transparent">
                        <Label Text="All Events" FontSize="11" TextColor="Black" HorizontalOptions="Center" VerticalOptions="Center" Padding="0,8"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding FilterCommand}" CommandParameter="AllEvents" Tapped="AllEventsTab_Tapped"/>
                        </Border.GestureRecognizers>
                    </Border>

                </Grid>
            </Border>
        </VerticalStackLayout>

        <CollectionView Grid.Row="3" ItemsSource="{Binding DisplayedEvents}" Margin="20,15,20,0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeShape="RoundRectangle 15" StrokeThickness="0" BackgroundColor="#F8F8F8" Margin="0,0,0,12" HeightRequest="130">
                        <Grid ColumnDefinitions="*, 110">

                            <VerticalStackLayout Padding="12" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding EventTitle}" FontAttributes="Bold" FontSize="18" TextColor="Black"/>
                                <Label Text="{Binding FormattedDate, StringFormat='• DATE: {0}'}" FontSize="10" TextColor="Gray"/>
                                <Label Text="{Binding FormattedTime, StringFormat='• TIME: {0}'}" FontSize="10" TextColor="Gray"/>
                                <Label Text="{Binding EventDescription}" FontSize="10" TextColor="Gray" MaxLines="2" LineBreakMode="TailTruncation"/>
                            </VerticalStackLayout>

                            <Grid Grid.Column="1">
                                <Image Source="{Binding EventImage}" Aspect="AspectFill"/>
                                <BoxView BackgroundColor="#4DD0E1" Opacity="0.5"/>

                                <Button Text="REGISTER" 
                                        BackgroundColor="#F4D03F" 
                                        TextColor="Black" 
                                        FontAttributes="Bold" 
                                        FontSize="11" 
                                        CornerRadius="15"
                                        HeightRequest="32"
                                        WidthRequest="90"
                                        HorizontalOptions="Center" 
                                        VerticalOptions="Center"
                                        Command="{Binding BindingContext.RegisterCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                        CommandParameter="{Binding .}"/>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Border Grid.Row="4" BackgroundColor="#4DD0E1" StrokeShape="RoundRectangle 25,25,0,0" Padding="20,10" HeightRequest="65" StrokeThickness="0">
            <Grid ColumnDefinitions="*, *, *, *">
                <ImageButton Grid.Column="0" 
                             Source="home.png" 
                             Command="{Binding NavigateToHomeCommand}"
                             CommandParameter="{Binding Source={RelativeSource Self}}"
                             HorizontalOptions="Center" 
                             VerticalOptions="Center" 
                             HeightRequest="24" 
                             WidthRequest="24" 
                             BackgroundColor="Transparent"/>

                <ImageButton Grid.Column="1" 
                             Source="proposals.png" 
                             Command="{Binding NavigateToProposalsCommand}"
                             CommandParameter="{Binding Source={RelativeSource Self}}"
                             HorizontalOptions="Center" 
                             VerticalOptions="Center" 
                             HeightRequest="28" 
                             WidthRequest="28" 
                             BackgroundColor="Transparent"/>

                <ImageButton Grid.Column="2" 
                             Source="events.png" 
                             HorizontalOptions="Center" 
                             VerticalOptions="Center" 
                             HeightRequest="26" 
                             WidthRequest="26" 
                             BackgroundColor="Transparent"/>
            </Grid>
        </Border>

    </Grid>
</ContentPage>