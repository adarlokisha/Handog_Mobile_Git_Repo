<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Handog_MobileApp.Views.Organizer.O_HOME"
             BackgroundColor="#F4F6F8"
             NavigationPage.HasNavigationBar="False">

    <Grid>
        <Grid RowDefinitions="Auto, *, Auto">

            <Border Grid.Row="0" BackgroundColor="#FAD02C" StrokeShape="RoundRectangle 0,0,24,24" StrokeThickness="0" Padding="20, 50, 20, 20" >
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,4" Radius="12" Opacity="0.05"/>
                </Border.Shadow>
                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="0">
                        <Label Text="Welcome," TextColor="#1A1A1A" FontSize="14" Opacity="0.7"/>
                        <Label Text="{Binding OrganizerName}" TextColor="#1A1A1A" FontSize="22" FontAttributes="Bold" Margin="0,2,0,0"/>
                    </VerticalStackLayout>

                    <!-- FIXED: Added explicit size to the container Grid and adjusted badge margins to prevent cropping -->
                    <Grid Grid.Column="1" VerticalOptions="Center" WidthRequest="34" HeightRequest="34">
                        <ImageButton Source="bell_black.png" WidthRequest="26" HeightRequest="26" HorizontalOptions="Center" VerticalOptions="Center" Command="{Binding ViewNotificationsCommand}" BackgroundColor="Transparent"/>
                        <Ellipse Fill="Red" WidthRequest="10" HeightRequest="10" HorizontalOptions="End" VerticalOptions="Start" Margin="0,2,2,0" IsVisible="{Binding HasUnreadNotifications}"/>
                    </Grid>
                </Grid>
            </Border>

            <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="16" Padding="0, 10, 0, 100">

                    <Grid HeightRequest="210" Margin="0,0,0,0">
                        <Image Source="o_greetingcard.png" Aspect="AspectFill"/>
                        <BoxView BackgroundColor="White" Opacity="0.12"/>
                        <VerticalStackLayout Padding="20" VerticalOptions="Center" Spacing="6">
                            <Label Text="CONNECTING HEARTS&#10;AND STRENGTHENING&#10;COMMUNITIES" TextColor="#1A1A1A" FontAttributes="Bold" FontSize="18" LineHeight="1.15"/>
                            <Label Text="Start bridging the gap by creating your event, organize now!" TextColor="#444444" FontSize="12" Margin="0,2,40,12"/>
                            <Button Text="+ ORGANIZE EVENT" Command="{Binding OrganizeEventCommand}" BackgroundColor="#00BAC7" TextColor="White" FontAttributes="Bold" HeightRequest="38" HorizontalOptions="Start" Padding="16,0" FontSize="12"/>
                        </VerticalStackLayout>
                    </Grid>

                    <Border Margin="20,4,20,0" StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="White">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,2" Radius="6" Opacity="0.05"/>
                        </Border.Shadow>
                        <Grid ColumnDefinitions="*, Auto" Padding="20" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="4">
                                <Label Text="VOLUNTEER ATTENDANCE RATE" TextColor="#1A1A1A" FontAttributes="Bold" FontSize="14"/>
                                <Label Text="{Binding AttendanceSummary}" TextColor="#777777" FontSize="12"/>
                            </VerticalStackLayout>

                            <Grid Grid.Column="1" WidthRequest="64" HeightRequest="64" HorizontalOptions="End">
                                <Ellipse Stroke="#F0F2F5" StrokeThickness="6" WidthRequest="60" HeightRequest="60"/>
                                <Ellipse Stroke="#FAD02C" StrokeThickness="6" StrokeDashArray="10, 2" WidthRequest="60" HeightRequest="60"/>
                                <Label Text="{Binding AttendancePercentage}" TextColor="#1A1A1A" FontAttributes="Bold" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- FIXED: Increased Padding, updated Margin, and Spacing for a less cramped look -->
                    <Border Margin="20,12,20,20" StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="White">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,2" Radius="6" Opacity="0.05"/>
                        </Border.Shadow>
                        <VerticalStackLayout Padding="24, 32" HorizontalOptions="Center" Spacing="20">
                            <Label Text="OUR STORY" TextColor="#E0B513" FontAttributes="Bold" FontSize="12" HorizontalOptions="Center" CharacterSpacing="1"/>
                            <Image Source="logo_teal.png" WidthRequest="240" Aspect="AspectFit" HorizontalOptions="Center" Margin="0,8"/>
                            <Label Text="Our platform was created with one simple goal — to make community engagement easier, more organized, and more accessible for everyone. We saw the gap between people who want to serve, those who need support, and organizers who are willing to lead initiatives, but lack a centralized system to connect them all." TextColor="#555555" FontSize="13" HorizontalTextAlignment="Center" LineHeight="1.5"/>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>

            <Border Grid.Row="2" BackgroundColor="#FAD02C" StrokeShape="RoundRectangle 35" StrokeThickness="0" HeightRequest="70" Margin="20, 0, 20, 25" VerticalOptions="End">
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,4" Radius="10" Opacity="0.15"/>
                </Border.Shadow>
                <Grid ColumnDefinitions="*, *, *, *">
                    <ImageButton Grid.Column="0" Source="home.png" HeightRequest="32" WidthRequest="32" HorizontalOptions="Center" VerticalOptions="Center" BackgroundColor="Transparent"/>
                    <ImageButton Grid.Column="1" Source="proposals.png" Command="{Binding NavigateProposalsCommand}" HeightRequest="26" WidthRequest="26" HorizontalOptions="Center" VerticalOptions="Center" BackgroundColor="Transparent"/>
                    <ImageButton Grid.Column="2" Source="events.png" Command="{Binding NavigateEventsCommand}" HeightRequest="26" WidthRequest="26" HorizontalOptions="Center" VerticalOptions="Center" BackgroundColor="Transparent"/>
                    <ImageButton Grid.Column="3" Source="profile.png" Command="{Binding NavigateProfileCommand}" HeightRequest="26" WidthRequest="26" HorizontalOptions="Center" VerticalOptions="Center" BackgroundColor="Transparent"/>
                </Grid>
            </Border>
        </Grid>

        <BoxView BackgroundColor="Transparent" IsVisible="{Binding IsNotificationPanelVisible}">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ViewNotificationsCommand}"/>
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border BackgroundColor="White" StrokeShape="RoundRectangle 12" StrokeThickness="0" WidthRequest="320" MaximumHeightRequest="400" HorizontalOptions="End" VerticalOptions="Start" Margin="0, 95, 16, 0" IsVisible="{Binding IsNotificationPanelVisible}">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,6" Radius="12" Opacity="0.15"/>
            </Border.Shadow>

            <Grid RowDefinitions="Auto, *">
                <Label Grid.Row="0" Text="Notifications" FontAttributes="Bold" FontSize="14" TextColor="#1A1A1A" Padding="16,12" BackgroundColor="#F4F6F8" />
                <BoxView Grid.Row="0" HeightRequest="1" Color="#EAEAEA" VerticalOptions="End"/>

                <CollectionView Grid.Row="1" ItemsSource="{Binding Notifications}">
                    <CollectionView.EmptyView>
                        <Label Text="No new notifications" TextColor="#777777" FontSize="12" HorizontalOptions="Center" Margin="0,30"/>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <ContentView>
                                <ContentView.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding BindingContext.NotificationTappedCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" CommandParameter="{Binding .}"/>
                                </ContentView.GestureRecognizers>

                                <Grid RowDefinitions="Auto, Auto, Auto" Padding="16,12" BackgroundColor="{Binding BgColor}">
                                    <Label Grid.Row="0" Text="{Binding Title}" FontAttributes="{Binding TitleFont}" TextColor="#1A1A1A" FontSize="13"/>
                                    <Label Grid.Row="1" Text="{Binding Message}" TextColor="#555555" FontSize="11" Margin="0,2,0,0" LineBreakMode="WordWrap"/>
                                    <BoxView Grid.Row="2" HeightRequest="1" Color="#F0F2F5" Margin="-16,12,-16,-12" VerticalOptions="End"/>
                                </Grid>
                            </ContentView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>

    </Grid>
</ContentPage>