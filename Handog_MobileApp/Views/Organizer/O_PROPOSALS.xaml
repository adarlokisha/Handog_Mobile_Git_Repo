<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Handog_MobileApp.Views.Organizer.O_PROPOSALS"
             xmlns:vm="clr-namespace:Handog_MobileApp.ViewModel.Organizer"
             BackgroundColor="White"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto, *, Auto">

        <Grid Grid.Row="0" BackgroundColor="#FAD02C" Padding="20, 50, 20, 15" ColumnDefinitions="*, Auto" IgnoreSafeArea="True">
            <HorizontalStackLayout Grid.Column="0" Spacing="5" VerticalOptions="Center">
                <Label Text="Hi," FontSize="20" TextColor="#1A1A1A" VerticalOptions="Center"/>
                <Label Text="{Binding HeaderUsername}" FontSize="20" FontAttributes="Bold" TextColor="#1A1A1A" VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20, 20, 20, 100" Spacing="10">

                <Image Source="proposals_black.png" HeightRequest="60" WidthRequest="60" HorizontalOptions="Center" />
                <Label Text="PROPOSALS" TextColor="#1A1A1A" FontSize="26" FontAttributes="Bold" HorizontalOptions="Center" CharacterSpacing="1.5"/>

                <Label Text="Can you host an event for us?" FontSize="20" FontAttributes="Bold" TextColor="#FAD02C" HorizontalOptions="Start" Margin="0,10,0,0"/>
                <Label Text="These are the event proposals currently submitted by your volunteers." FontSize="14" TextColor="#777777" HorizontalOptions="Start" LineHeight="1.2"/>

                <BoxView HeightRequest="1" Color="#DDDDDD" Margin="0, 15, 0, 10"/>

                <Border Margin="0, 0, 0, 15" StrokeShape="RoundRectangle 20" StrokeThickness="0" BackgroundColor="#EFEFEF" Padding="2">
                    <Grid ColumnDefinitions="*, *">
                        <Border Grid.Column="0" StrokeShape="RoundRectangle 18" StrokeThickness="0" BackgroundColor="{Binding PendingTabColor}">
                            <Label Text="Pending" FontAttributes="Bold" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center" Padding="0,8"/>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SwitchTabCommand}" CommandParameter="Pending"/>
                            </Border.GestureRecognizers>
                        </Border>
                        <Border Grid.Column="1" StrokeShape="RoundRectangle 18" StrokeThickness="0" BackgroundColor="{Binding CompletedTabColor}">
                            <Label Text="Completed" FontAttributes="Bold" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center" Padding="0,8"/>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SwitchTabCommand}" CommandParameter="Completed"/>
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>
                </Border>

                <Label Text="{Binding ListTitle}" FontSize="13" FontAttributes="Bold" TextColor="#1A1A1A" Margin="0,0,0,5"/>

                <CollectionView ItemsSource="{Binding Proposals}">

                    <CollectionView.EmptyView>
                        <Label Text="No proposals found in this category." TextColor="#999999" FontSize="13" FontAttributes="Italic" HorizontalOptions="Center" Margin="0,30,0,0"/>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,15" StrokeShape="RoundRectangle 16" StrokeThickness="1" Stroke="#E0E0E0" BackgroundColor="White" Padding="15">
                                <Border.Shadow>
                                    <Shadow Brush="#000000" Offset="0,2" Radius="6" Opacity="0.05"/>
                                </Border.Shadow>

                                <VerticalStackLayout Spacing="8">

                                    <Label Text="{Binding ProposerName, StringFormat='NAME OF REQUESTOR: {0}'}" FontSize="12" FontAttributes="Bold" TextColor="#999999" TextTransform="Uppercase"/>

                                    <BoxView HeightRequest="1" Color="#EEEEEE" Margin="0,2"/>

                                    <HorizontalStackLayout Spacing="5">
                                        <Label Text="{Binding ProposalTitle}" FontSize="13" FontAttributes="Bold" TextColor="#1A1A1A"/>
                                    </HorizontalStackLayout>

                                    <Label Text="{Binding ProposalDetails}" FontSize="13" TextColor="#555555" LineHeight="1.2" Margin="0,5,0,0"/>

                                    <Grid Margin="0,5,0,0">

                                        <HorizontalStackLayout HorizontalOptions="End" Spacing="10" 
                                                               IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:ProposalsViewModel}}, Path=IsPendingView}">
                                            <ImageButton Source="check.png" WidthRequest="40" HeightRequest="40"
                                                         Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProposalsViewModel}}, Path=AcceptCommand}"
                                                         CommandParameter="{Binding .}" BackgroundColor="Transparent"/>
                                            <ImageButton Source="x.png" WidthRequest="40" HeightRequest="40"
                                                         Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProposalsViewModel}}, Path=RejectCommand}"
                                                         CommandParameter="{Binding .}" BackgroundColor="Transparent"/>
                                        </HorizontalStackLayout>

                                        <Label Text="{Binding ProposalStatus}" 
                                               HorizontalOptions="End" VerticalOptions="Center"
                                               FontAttributes="Bold" FontSize="14" TextColor="#1A1A1A"
                                               IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:ProposalsViewModel}}, Path=IsCompletedView}"/>
                                    </Grid>

                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="2" BackgroundColor="#FAD02C" StrokeShape="RoundRectangle 35" StrokeThickness="0" HeightRequest="70" Margin="20, 0, 20, 25" VerticalOptions="End">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,4" Radius="10" Opacity="0.15"/>
            </Border.Shadow>

            <Grid ColumnDefinitions="*, *, *, *">
                <ImageButton Grid.Column="0" Source="home.png" Command="{Binding NavigateCommand}" CommandParameter="Home" HeightRequest="26" WidthRequest="26" HorizontalOptions="Center" VerticalOptions="Center" BackgroundColor="Transparent"/>
                <ImageButton Grid.Column="1" Source="proposals.png" Command="{Binding NavigateCommand}" CommandParameter="Proposals" HeightRequest="32" WidthRequest="32" HorizontalOptions="Center" VerticalOptions="Center" BackgroundColor="Transparent"/>
                <ImageButton Grid.Column="2" Source="events.png" Command="{Binding NavigateCommand}" CommandParameter="Events" HeightRequest="26" WidthRequest="26" HorizontalOptions="Center" VerticalOptions="Center" BackgroundColor="Transparent"/>
                <ImageButton Grid.Column="3" Source="profile.png" Command="{Binding NavigateCommand}" CommandParameter="Profile" HeightRequest="26" WidthRequest="26" HorizontalOptions="Center" VerticalOptions="Center" BackgroundColor="Transparent"/>
            </Grid>
        </Border>

    </Grid>
</ContentPage>