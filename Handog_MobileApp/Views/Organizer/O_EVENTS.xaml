<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Handog_MobileApp"
             x:Class="Handog_MobileApp.Views.Organizer.O_EVENTS"
             BackgroundColor="#F4F6F8"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto, *, Auto">

        <VerticalStackLayout Grid.Row="0" BackgroundColor="#FAD02C" Padding="20, 50, 20, 20" IgnoreSafeArea="True" Spacing="15">
            <Grid ColumnDefinitions="*, Auto">
                <HorizontalStackLayout Grid.Column="0" Spacing="5" VerticalOptions="Center">
                    <Label Text="Hi," FontSize="20" TextColor="#1A1A1A" VerticalOptions="Center"/>
                    <Label Text="{Binding OrganizerNameHeader}" FontSize="20" FontAttributes="Bold" TextColor="#1A1A1A" VerticalOptions="Center"/>
                </HorizontalStackLayout>
  
            </Grid>

            <Border StrokeShape="RoundRectangle 22" StrokeThickness="0" BackgroundColor="White" HeightRequest="44">
                <SearchBar Text="{Binding SearchQuery}" Placeholder="Search events..." TextColor="#1A1A1A" BackgroundColor="Transparent"/>
            </Border>
        </VerticalStackLayout>

        <Grid Grid.Row="1" RowDefinitions="Auto, Auto, *" Margin="20, 15, 20, 0">

            <VerticalStackLayout Grid.Row="0" Spacing="5" Margin="0, 5, 0, 10">
                <Image Source="events_black.png" HeightRequest="60" WidthRequest="60" HorizontalOptions="Center" />
                <Label Text="EVENTS" TextColor="#1A1A1A" FontSize="26" FontAttributes="Bold" HorizontalOptions="Center" CharacterSpacing="1.5"/>
            </VerticalStackLayout>

            <Border Grid.Row="1" Margin="0, 10, 0, 5" StrokeShape="RoundRectangle 20" StrokeThickness="0" BackgroundColor="#EFEFEF" Padding="2">
                <Grid ColumnDefinitions="*, *, *">
                    <Border Grid.Column="0" StrokeShape="RoundRectangle 18" StrokeThickness="0" BackgroundColor="{Binding MyEventsTabColor}">
                        <Label Text="My Events" FontAttributes="Bold" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center" Padding="0,8"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SwitchTabCommand}" CommandParameter="MyEvents"/>
                        </Border.GestureRecognizers>
                    </Border>
                    <Border Grid.Column="1" StrokeShape="RoundRectangle 18" StrokeThickness="0" BackgroundColor="{Binding AllEventsTabColor}">
                        <Label Text="All Events" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center" Padding="0,8"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SwitchTabCommand}" CommandParameter="AllEvents"/>
                        </Border.GestureRecognizers>
                    </Border>
                    <Border Grid.Column="2" StrokeShape="RoundRectangle 18" StrokeThickness="0" BackgroundColor="{Binding CompletedTabColor}">
                        <Label Text="Completed" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center" Padding="0,8"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SwitchTabCommand}" CommandParameter="Completed"/>
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>
            </Border>

            <CollectionView Grid.Row="2" Margin="0, 10, 0, 0" SelectionMode="None" ItemsSource="{Binding GlobalEventsList}" >
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,6,0,10" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 16" BackgroundColor="White" Padding="0">
                            <Border.Shadow>
                                <Shadow Brush="#000000" Offset="0,2" Radius="6" Opacity="0.05"/>
                            </Border.Shadow>

                            <Grid ColumnDefinitions="*, *" MinimumHeightRequest="150">
                                <VerticalStackLayout Grid.Column="0" Padding="12" Spacing="2">
                                    <Button Text="X" 
                                        IsVisible="{Binding IsMyEvent}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:EventsViewModel}}, Path=CancelEventCommand}" 
                                        CommandParameter="{Binding .}" 
                                        BackgroundColor="Red" TextColor="White" FontAttributes="Bold"
                                        WidthRequest="24" HeightRequest="24" CornerRadius="4" Padding="0"
                                        HorizontalOptions="Start" Margin="0,0,0,4"/>
                                    
                                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="6">
                                        <Label Grid.Column="0" Text="{Binding EventTitle}" FontAttributes="Bold" FontSize="15" TextColor="#1A1A1A" TextDecorations="Underline" LineBreakMode="WordWrap" VerticalOptions="Center"/>

                                        <Border Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 8" BackgroundColor="{Binding StatusBadgeColor}" Padding="6,2" VerticalOptions="Center">
                                            <Label Text="{Binding StatusLabel}" TextColor="{Binding StatusTextColor}" FontSize="9" FontAttributes="Bold"/>
                                        </Border>
                                    </Grid>

                                    <VerticalStackLayout Spacing="2" Margin="0,6,0,6">
                                        <Label Text="{Binding EventVenue, StringFormat='• {0}'}" TextColor="#777777" FontSize="12" LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding EventDate, StringFormat='• {0}'}" TextColor="#777777" FontSize="12"/>
                                        <Label Text="{Binding EventTime, StringFormat='• {0}'}" TextColor="#777777" FontSize="12"/>
                                    </VerticalStackLayout>

                                    <Label Text="{Binding EventDetails}" TextColor="#777777" FontSize="12" LineBreakMode="TailTruncation" MaxLines="2"/>

                                    <Label Text="{Binding RejectionReason, StringFormat='Reason: {0}'}" IsVisible="{Binding HasRejectionReason}" TextColor="#FF5A5F" FontSize="11" FontAttributes="Italic" Margin="0,4,0,0" LineBreakMode="WordWrap"/>

                                    <Button Text="EDIT &amp; RESUBMIT"
                                            IsVisible="{Binding CanEdit}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:EventsViewModel}}, Path=EditEventCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#FF5A5F" TextColor="White" FontAttributes="Bold" FontSize="11"
                                            CornerRadius="14" HeightRequest="32" Padding="12,0" HorizontalOptions="Start" Margin="0,6,0,0"/>
                                </VerticalStackLayout>

                                <Grid Grid.Column="1" Padding="0">
                                    <Image Source="{Binding CategoryImage}" Aspect="AspectFill" />
                                    <Button Text="{Binding DynamicButtonText}" 
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:EventsViewModel}}, Path=ViewEventDetailsCommand}" 
                                    CommandParameter="{Binding .}" 
                                    BackgroundColor="#FAD02C" TextColor="#1A1A1A" FontAttributes="Bold" FontSize="12" 
                                    CornerRadius="16" HorizontalOptions="Center" VerticalOptions="Center" 
                                    HeightRequest="36" Padding="16,0"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Grid.Row="2" Text="+ ORGANIZE" Command="{Binding TogglePanelCommand}" CommandParameter="OpenOrganize" BackgroundColor="#00BAC7" TextColor="White" FontAttributes="Bold" CornerRadius="22" HeightRequest="44" WidthRequest="140" HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,35"/>
        </Grid>

        <Grid Grid.RowSpan="3" BackgroundColor="#80000000" IsVisible="{Binding IsOrganizePanelVisible}" Padding="20">
            <Border VerticalOptions="Center" StrokeShape="RoundRectangle 16" BackgroundColor="White" Padding="20">
                <ScrollView HeightRequest="500">
                    <VerticalStackLayout Spacing="15">
                        <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                            <Label Text="Organize Event" FontSize="20" FontAttributes="Bold"/>
                            <ImageButton Source="close_black.png" WidthRequest="24" HeightRequest="24" Command="{Binding TogglePanelCommand}" CommandParameter="CloseOrganize" BackgroundColor="Transparent"/>
                        </Grid>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="ORGANIZER" FontSize="10" FontAttributes="Bold" TextColor="#777777"/>
                            <Entry Text="{Binding FormOrganizer}" IsReadOnly="True" BackgroundColor="#F2F4F7"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="5">
                            <Label Text="EMAIL" FontSize="10" FontAttributes="Bold" TextColor="#777777"/>
                            <Entry Text="{Binding FormEmail}" IsReadOnly="True" BackgroundColor="#F2F4F7"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="CATEGORY *" FontSize="10" FontAttributes="Bold"/>
                            <Picker Title="Select Category" ItemsSource="{Binding CategoriesList}" ItemDisplayBinding="{Binding CategoryName}" SelectedItem="{Binding SelectedCategory}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="EVENT TITLE *" FontSize="10" FontAttributes="Bold"/>
                            <Entry Text="{Binding FormTitle}" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="5">
                                <Label Text="VENUE NAME *" FontSize="10" FontAttributes="Bold"/>
                                <Entry Text="{Binding FormVenue}" Placeholder="e.g. Covered Court" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="5">
                                <Label Text="ADDRESS" FontSize="10" FontAttributes="Bold"/>
                                <Entry Text="{Binding FormAddress}" Placeholder="Complete address" />
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="5">
                                <Label Text="DATE *" FontSize="10" FontAttributes="Bold"/>
                                <DatePicker Date="{Binding FormDate}" Format="yyyy-MM-dd"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="5">
                                <Label Text="CAPACITY *" FontSize="10" FontAttributes="Bold"/>
                                <Entry Text="{Binding FormCapacity}" Keyboard="Numeric" Placeholder="e.g., 50"/>
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="5">
                                <Label Text="START TIME *" FontSize="10" FontAttributes="Bold"/>
                                <TimePicker Time="{Binding FormStartTime}" Format="HH:mm"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="5">
                                <Label Text="END TIME *" FontSize="10" FontAttributes="Bold"/>
                                <TimePicker Time="{Binding FormEndTime}" Format="HH:mm"/>
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="EVENT DESCRIPTION" FontSize="10" FontAttributes="Bold"/>
                            <Editor Text="{Binding FormDetails}" HeightRequest="80"/>
                        </VerticalStackLayout>

                        <Button Text="SUBMIT FOR APPROVAL" Command="{Binding PublishEventCommand}" BackgroundColor="#00BAC7" TextColor="White" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>

        <Border Grid.Row="2" BackgroundColor="#FAD02C" StrokeShape="RoundRectangle 35" StrokeThickness="0" HeightRequest="70" Margin="20, 0, 20, 25" VerticalOptions="End">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,4" Radius="10" Opacity="0.15"/>
            </Border.Shadow>

            <Grid ColumnDefinitions="*, *, *, *">
                <ImageButton Grid.Column="0" Source="home.png" Command="{Binding NavigateCommand}" CommandParameter="Home" HeightRequest="26" WidthRequest="26" HorizontalOptions="Center" VerticalOptions="Center" BackgroundColor="Transparent"/>
                <ImageButton Grid.Column="1" Source="proposals.png" Command="{Binding NavigateCommand}" CommandParameter="Proposals" HeightRequest="26" WidthRequest="26" HorizontalOptions="Center" VerticalOptions="Center" BackgroundColor="Transparent"/>

                <ImageButton Grid.Column="2" Source="events.png" HeightRequest="32" WidthRequest="32" HorizontalOptions="Center" VerticalOptions="Center" BackgroundColor="Transparent"/>

                <ImageButton Grid.Column="3" Source="profile.png" Command="{Binding NavigateCommand}" CommandParameter="Profile" HeightRequest="26" WidthRequest="26" HorizontalOptions="Center" VerticalOptions="Center" BackgroundColor="Transparent"/>
            </Grid>
        </Border>

    </Grid>
</ContentPage>