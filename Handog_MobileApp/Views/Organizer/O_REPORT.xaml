<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Handog_MobileApp.ViewModels.Organizer"
             x:Class="Handog_MobileApp.Views.Organizer.O_REPORT"
             BackgroundColor="#F4F6F8"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto, *">

        <VerticalStackLayout Grid.Row="0" Spacing="0" BackgroundColor="#FAD02C" IgnoreSafeArea="True" Padding="0, 48, 0, 16">
            <Grid ColumnDefinitions="Auto, *" Padding="16, 0">
                <ImageButton Grid.Column="0" Source="back_black.png" Command="{Binding GoBackCommand}" WidthRequest="24" HeightRequest="24" BackgroundColor="Transparent"/>
                <Label Grid.Column="1" Text="Event Report" TextColor="#1A1A1A" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Center" Margin="-24,0,0,0"/>
            </Grid>
        </VerticalStackLayout>

        <ScrollView Grid.Row="1" Padding="16">
            <VerticalStackLayout Spacing="16">

                <Border StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="White" Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,2" Radius="6" Opacity="0.05"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding CurrentEvent.EventTitle}" FontSize="22" FontAttributes="Bold" TextColor="#1A1A1A"/>
                        <Label Text="{Binding CurrentEvent.OrganizerName, StringFormat='Organized by: {0}'}" TextColor="#00BAC7" FontAttributes="Bold" FontSize="12"/>

                        <BoxView HeightRequest="1" Color="#EEEEEE" Margin="0,8"/>

                        <Grid ColumnDefinitions="20, *" RowDefinitions="Auto, Auto, Auto" RowSpacing="8">
                            <Label Grid.Row="0" Grid.Column="0" Text="📅" FontSize="12" VerticalOptions="Center"/>
                            <Label Grid.Row="0" Grid.Column="1" TextColor="#555555" FontSize="13">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding CurrentEvent.EventDate}"/>
                                        <Span Text=" at "/>
                                        <Span Text="{Binding CurrentEvent.EventTime}"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <Label Grid.Row="1" Grid.Column="0" Text="📍" FontSize="12" VerticalOptions="Center"/>
                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="0">
                                <Label Text="{Binding CurrentEvent.EventVenue}" TextColor="#555555" FontAttributes="Bold" FontSize="13"/>
                                <Label Text="{Binding CurrentEvent.EventAddress}" TextColor="#777777" FontSize="12"/>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="White" Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,2" Radius="6" Opacity="0.05"/>
                    </Border.Shadow>

                    <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto, Auto" RowSpacing="12">
                        <Label Grid.Row="0" Grid.ColumnSpan="2" Text="Final Metrics" FontAttributes="Bold" FontSize="16" TextColor="#1A1A1A" Margin="0,0,0,5"/>

                        <VerticalStackLayout Grid.Row="1" Grid.Column="0">
                            <Label Text="Expected" FontSize="11" TextColor="#777777" FontAttributes="Bold"/>
                            <Label Text="{Binding ReportExpected}" FontSize="18" TextColor="#1A1A1A" FontAttributes="Bold"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="1" Grid.Column="1">
                            <Label Text="Attended" FontSize="11" TextColor="#777777" FontAttributes="Bold"/>
                            <Label Text="{Binding ReportPresent}" FontSize="18" TextColor="#00BAC7" FontAttributes="Bold"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="2" Grid.Column="0">
                            <Label Text="Attendance Rate" FontSize="11" TextColor="#777777" FontAttributes="Bold"/>
                            <Label Text="{Binding ReportRate}" FontSize="18" TextColor="#1A1A1A" FontAttributes="Bold"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="2" Grid.Column="1">
                            <Label Text="Completed On" FontSize="11" TextColor="#777777" FontAttributes="Bold"/>
                            <Label Text="{Binding ReportDate}" FontSize="14" TextColor="#1A1A1A" VerticalOptions="Center"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- 3. VOLUNTEER LEDGER -->
                <Label Text="Volunteer Ledger" FontAttributes="Bold" FontSize="16" TextColor="#1A1A1A" Margin="0,8,0,0"/>

                <!-- Swapped CollectionView for BindableLayout to fix MAUI scroll bug -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding AttendeesList}" Spacing="0">
                    <BindableLayout.EmptyView>
                        <Label Text="No volunteers recorded for this event." TextColor="#999999" HorizontalOptions="Center" Margin="0,20"/>
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,4" StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="White" Padding="12">
                                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                    <Label Grid.Column="0" Text="{Binding VolunteerName}" FontAttributes="Bold" FontSize="14" TextColor="#1A1A1A" VerticalOptions="Center"/>

                                    <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                        <Ellipse WidthRequest="10" HeightRequest="10" Fill="{Binding StatusColor}" VerticalOptions="Center"/>
                                        <Label Text="{Binding AttendanceStatus}" FontAttributes="Bold" FontSize="12" TextColor="{Binding StatusColor}" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage> 