<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Handog_MobileApp.ViewModels.UserManagement"
             x:Class="Handog_MobileApp.Views.UserManagement.SignUpRolePage"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.BindingContext>
        <viewModels:SignUpRoleViewModel />
    </ContentPage.BindingContext>

    <!-- Page background -->
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4DD0E1" Offset="0.0" />
            <GradientStop Color="White" Offset="0.4" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#83E8FF" Offset="0.0" />
                <GradientStop Color="#FFFFFF" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView VerticalOptions="Center">
            <VerticalStackLayout Spacing="25" Padding="20">

                <!-- Logo -->
                <Image Source="login_logo.png"
                       HeightRequest="100"
                       WidthRequest="220"
                       HorizontalOptions="Center"
                       Aspect="AspectFit"
                       Margin="0,0,0,5"/>

                <!-- Card container -->
                <Border StrokeShape="RoundRectangle 25"
                        StrokeThickness="0"
                        BackgroundColor="White"
                        HorizontalOptions="Center"
                        WidthRequest="350"
                        Padding="25,30">
                    <Border.Shadow>
                        <Shadow Brush="#000000"
                                Offset="0,10"
                                Radius="20"
                                Opacity="0.1" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="20">

                        <Label Text="Get Started"
                               FontSize="22"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="Black" />

                        <Label Text="Let's get started by choosing your role below."
                               FontSize="13"
                               HorizontalOptions="Center"
                               TextColor="#555555" />

                        <Label Text="Are you here to volunteer or to organize?"
                               TextColor="Black"
                               FontAttributes="Bold"
                               FontSize="14"
                               HorizontalOptions="Fill"
                               Margin="0,5,0,0"/>

                        <!-- Role options -->
                        <VerticalStackLayout Spacing="15">

                            <!-- Volunteer -->
                            <Border StrokeShape="RoundRectangle 12"
                                    Stroke="{Binding VolunteerStrokeColor}"
                                    StrokeThickness="{Binding VolunteerStrokeThickness}"
                                    BackgroundColor="{Binding VolunteerBackgroundColor}"
                                    Padding="15">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Volunteer"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{Binding VolunteerTextColor}"
                                           TextDecorations="Underline"/>
                                    <Label Text="I want to volunteer and contribute my time and skills to a great cause."
                                           FontSize="12.5"
                                           TextColor="#444444"/>
                                </VerticalStackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectVolunteerCommand}" />
                                </Border.GestureRecognizers>
                            </Border>

                            <!-- Organizer -->
                            <Border StrokeShape="RoundRectangle 12"
                                    Stroke="{Binding OrganizerStrokeColor}"
                                    StrokeThickness="{Binding OrganizerStrokeThickness}"
                                    BackgroundColor="{Binding OrganizerBackgroundColor}"
                                    Padding="15">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Organizer"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{Binding OrganizerTextColor}"
                                           TextDecorations="Underline"/>
                                    <Label Text="I want to organize and manage initiatives to create positive change."
                                           FontSize="12.5"
                                           TextColor="#444444"/>
                                </VerticalStackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectOrganizerCommand}" />
                                </Border.GestureRecognizers>
                            </Border>

                        </VerticalStackLayout>

                        <!-- Continue button -->
                        <Grid HeightRequest="48" Margin="0,10,0,0">
                            <Border StrokeShape="RoundRectangle 24" StrokeThickness="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#17C3EE" Offset="0.0" />
                                        <GradientStop Color="#F3D968" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <Button Text="CONTINUE"
                                    Command="{Binding ContinueCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    CornerRadius="24"/>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
