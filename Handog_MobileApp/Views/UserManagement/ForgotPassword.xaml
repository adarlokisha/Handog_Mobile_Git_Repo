<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Handog_MobileApp.ViewModels.UserManagement"
             x:Class="Handog_MobileApp.Views.UserManagement.ForgotPasswordPage"
             Title="Forgot Password"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.BindingContext>
        <viewModels:ForgotPasswordViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4DD0E1" Offset="0.0" />
            <GradientStop Color="White" Offset="0.4" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <VerticalStackLayout Padding="25,20" Spacing="10" VerticalOptions="Fill">

        <Image Source="login_logo.png"
               HeightRequest="120"
               WidthRequest="280"
               HorizontalOptions="Center"
               Aspect="AspectFit"
               Margin="0,0,0,5"/>

        <Frame BackgroundColor="White"
               CornerRadius="10"
               Padding="20"
               HasShadow="True">

            <VerticalStackLayout Spacing="15">
                <Label Text="Forgot Password"
                       FontSize="24"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"/>

                <Label Text="Enter your email address below, and we'll send you instructions to reset your password."
                       FontSize="14"
                       TextColor="Gray"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"/>

                <Border BackgroundColor="#EBEBEB"
                        StrokeThickness="0"
                        HeightRequest="45">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Entry Placeholder="Email*"
                           Keyboard="Email"
                           BackgroundColor="Transparent"
                           PlaceholderColor="#A0A0A0"
                           TextColor="#333333"
                           Margin="10,0"
                           Text="{Binding Email}" />
                </Border>

                <Button Text="Send Reset Link"
                        TextColor="White"
                        CornerRadius="25"
                        Command="{Binding ResetCommand}">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#26C6DA" Offset="0.0"/>
                            <GradientStop Color="#DCE775" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>

                <Label Text="Go back to Log In"
                       TextColor="Black"
                       TextDecorations="Underline"
                       HorizontalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackToLoginCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>
        </Frame>
    </VerticalStackLayout>
</ContentPage>
