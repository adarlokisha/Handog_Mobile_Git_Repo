<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Handog_MobileApp.ViewModels.UserManagement"
             x:Class="Handog_MobileApp.Views.UserManagement.SignUpVerificationPage"
             Title="Verification">

    <VerticalStackLayout Padding="20" Spacing="15" VerticalOptions="Center">

        <Label Text="Enter the verification code sent to your email"
               FontSize="16"
               HorizontalOptions="Center"
               TextColor="Black" />

        <Entry Placeholder="Verification Code"
               Text="{Binding EnteredCode}"
               Keyboard="Numeric"
               TextColor="Black" />

        <Button Text="Verify"
                Command="{Binding VerifyCommand}"
                BackgroundColor="#17C3EE"
                TextColor="White"
                CornerRadius="24" />
    </VerticalStackLayout>
</ContentPage>
