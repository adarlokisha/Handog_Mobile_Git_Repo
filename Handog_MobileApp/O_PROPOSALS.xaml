<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Handog_MobileApp.O_PROPOSALS"
             xmlns:vm="clr-namespace:Handog_MobileApp.ViewModel.Organizer"
             BackgroundColor="#F4F6F8"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto, Auto, *, Auto">

        <VerticalStackLayout Grid.Row="0" Spacing="10" BackgroundColor="#FAD02C" IgnoreSafeArea="True" Padding="0, 60, 0, 30">
            <Image Source="proposals_black.png" HeightRequest="60" WidthRequest="60" HorizontalOptions="Center" />
            <Label Text="PROPOSALS" TextColor="#1A1A1A" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" CharacterSpacing="1.5"/>
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1" Padding="20, 30, 20, 10" Spacing="12">
            <Label Text="We are in need of help!" FontSize="24" FontAttributes="Bold" TextColor="#1A1A1A"/>
            <Label Text="These are the event proposals currently submitted by your volunteers." FontSize="15" TextColor="#777777" LineHeight="1.2"/>
            <BoxView HeightRequest="1" Color="#DDDDDD" Margin="0, 15, 0, 10"/>
            <Label Text="PENDING PROPOSALS" FontSize="13" FontAttributes="Bold" TextColor="#00BAC7"/>
        </VerticalStackLayout>

        <ContentView Grid.Row="2" Padding="15, 0, 15, 15">
            <CollectionView ItemsSource="{Binding Proposals}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,8" StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="White" Padding="20">
                            <Border.Shadow>
                                <Shadow Brush="#000000" Offset="0,2" Radius="6" Opacity="0.05"/>
                            </Border.Shadow>
                            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="{Binding ProposalTitle}" FontSize="16" FontAttributes="Bold" TextColor="#1A1A1A"/>
                                    <Label Text="{Binding ProposerName, StringFormat='Requested by: {0}'}" FontSize="13" TextColor="#777777"/>
                                </VerticalStackLayout>
                                <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                                    <ImageButton Source="check.png" WidthRequest="40" HeightRequest="40"
                                                 Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProposalsViewModel}}, Path=AcceptCommand}"
                                                 CommandParameter="{Binding .}" BackgroundColor="Transparent"/>
                                    <ImageButton Source="x.png" WidthRequest="40" HeightRequest="40"
                                                 Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProposalsViewModel}}, Path=RejectCommand}"
                                                 CommandParameter="{Binding .}" BackgroundColor="Transparent"/>
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </ContentView>
        
        <Border Grid.Row="3" BackgroundColor="#FAD02C" StrokeShape="RoundRectangle 20,20,0,0" HeightRequest="60" Padding="0">
            <Grid ColumnDefinitions="*, *, *, *">
                <ImageButton Grid.Column="0" Source="home.png" Command="{Binding NavigateCommand}" CommandParameter="Home" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center" VerticalOptions="Center"/>
                <ImageButton Grid.Column="1" Source="proposals.png" Command="{Binding NavigateCommand}" CommandParameter="Proposals" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center" VerticalOptions="Center"/>
                <ImageButton Grid.Column="2" Source="events.png" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center" VerticalOptions="Center"/>
                <ImageButton Grid.Column="3" Source="profile.png" Command="{Binding NavigateCommand}" CommandParameter="Profile" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Grid>
        </Border>

    </Grid>
</ContentPage>