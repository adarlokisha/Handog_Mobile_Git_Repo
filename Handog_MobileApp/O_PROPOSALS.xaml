<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Handog_MobileApp.O_PROPOSALS"
             BackgroundColor="#F4F6F8"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto, *, Auto" BackgroundColor="#F4F6F8">

        <VerticalStackLayout Grid.Row="0" Spacing="0" BackgroundColor="#F4F6F8">
            <Grid BackgroundColor="#FAD02C" ColumnDefinitions="Auto, *, Auto" Padding="16, 16, 16, 16">
                <ImageButton Grid.Column="0"
                             Source="back_black.png" 
                             Clicked="BackBtn_Clicked"
                             WidthRequest="24" HeightRequest="24"
                             BackgroundColor="Transparent"
                             VerticalOptions="Center"
                             HorizontalOptions="Start"/>

                <HorizontalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="4">
                    <Label Text="Hi," TextColor="#1A1A1A" FontSize="15" Opacity="0.8" VerticalOptions="Center"/>
                    <Label Text="Username!" TextColor="#1A1A1A" FontSize="15" FontAttributes="Bold" VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Grid>

            <VerticalStackLayout Padding="24, 24, 24, 16" HorizontalOptions="Center" Spacing="8">
                <Image Source="proposals_black.png" HeightRequest="44" WidthRequest="44" HorizontalOptions="Center" />
                <Label Text="PROPOSALS" TextColor="#1A1A1A" FontAttributes="Bold" FontSize="26" CharacterSpacing="1" HorizontalOptions="Center"/>
                <Label Text="Can you host an event for us?" TextColor="#E0B513" FontAttributes="Bold" FontSize="16" HorizontalOptions="Center"/>
                <Label Text="These are the requests currently sent by your volunteers." TextColor="#777777" FontSize="12" HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <BoxView HeightRequest="1" Color="#EAEAEA" Margin="20,8" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" 
                        Margin="16,4" 
                        SelectionMode="None">

            <CollectionView.Header>
                <Label Text="PENDING REQUESTS" TextColor="#1A1A1A" FontAttributes="Bold" FontSize="13" CharacterSpacing="0.5" Margin="4,0,0,8"/>
            </CollectionView.Header>

            <CollectionView.ItemsSource>
                <x:Array Type="{x:Type x:String}">
                    <x:String>Card 1</x:String>
                    <x:String>Card 2</x:String>
                    <x:String>Card 3</x:String>
                </x:Array>
            </CollectionView.ItemsSource>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,6" StrokeShape="RoundRectangle 12" StrokeThickness="0" Stroke="Transparent" BackgroundColor="White">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,2" Radius="6" Opacity="0.04"/>
                        </Border.Shadow>

                        <VerticalStackLayout Padding="16" Spacing="8">
                            <Label Text="NAME OF REQUESTOR" TextColor="#888888" FontAttributes="Bold" FontSize="11" CharacterSpacing="0.5"/>
                            <BoxView HeightRequest="1" Color="#F0F2F5" />
                            <Label Text="TYPE OF REQUEST: TYPE" TextColor="#1A1A1A" FontAttributes="Bold" FontSize="14"/>
                            <Label Text="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua." TextColor="#555555" FontSize="12" LineHeight="1.35"/>

                            <Grid Margin="0,4,0,0">
                                <HorizontalStackLayout HorizontalOptions="End" Spacing="12">
                                    <ImageButton Source="x.png" WidthRequest="24" HeightRequest="24" BackgroundColor="Transparent"/>
                                    <ImageButton Source="check.png" WidthRequest="24" HeightRequest="24" BackgroundColor="Transparent"/>
                                </HorizontalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Border Grid.Row="2" BackgroundColor="#FAD02C" StrokeShape="RoundRectangle 20,20,0,0" StrokeThickness="0" HeightRequest="60" Padding="12, 0">
            <Grid ColumnDefinitions="*, *, *, *">
                <ImageButton Grid.Column="0" Source="home.png" Clicked="HomeBtn_Clicked" HorizontalOptions="Center" VerticalOptions="Center" HeightRequest="24" WidthRequest="24" BackgroundColor="Transparent"/>
                <ImageButton Grid.Column="1" Source="proposals.png" HorizontalOptions="Center" VerticalOptions="Center" HeightRequest="28" WidthRequest="28" BackgroundColor="Transparent"/>
                <ImageButton Grid.Column="2" Source="events.png" Clicked="EventsBtn_Clicked" HorizontalOptions="Center" VerticalOptions="Center" HeightRequest="24" WidthRequest="24" BackgroundColor="Transparent"/>
                <ImageButton Grid.Column="3" Source="profile.png" Clicked="ProfileBtn_Clicked" HorizontalOptions="Center" VerticalOptions="Center" HeightRequest="24" WidthRequest="24" BackgroundColor="Transparent"/>
            </Grid>
        </Border>

    </Grid>
</ContentPage>