<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Handog_MobileApp.O_PROPOSALS"
             Title="Organizer Proposals"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto, *">
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Padding="15,10" VerticalOptions="Start">
            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                <Image Source="tugmalogo1.png" WidthRequest="32" HeightRequest="32"/>
                <Label Text="Tugma" FontAttributes="Bold" FontSize="18" VerticalOptions="Center"/>
            </HorizontalStackLayout>
            <Button Grid.Column="1" Text="LOGOUT" Clicked="OnLogoutClicked" BackgroundColor="Transparent" FontAttributes="Bold"/>
        </Grid>

        <ScrollView Grid.Row="1" Padding="20">
            <VerticalStackLayout Spacing="15">
                <Label Text="We are in need of help!" FontSize="24" FontAttributes="Bold"/>
                <Label Text="These are the event proposals currently submitted by your volunteers." FontSize="14" Margin="0,0,0,5"/>

                <BoxView HeightRequest="1" HorizontalOptions="Fill"/>
                <Label Text="PENDING PROPOSALS" FontSize="12" FontAttributes="Bold" Margin="0,5"/>

                <CollectionView x:Name="CollProposals" ItemsSource="{Binding ActiveProposalsCollection}" Margin="0,10">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeShape="RoundRectangle 10" StrokeThickness="1" Padding="15" Margin="0,0,0,12">
                                <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*, Auto">

                                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding [ProposerName]}" FontAttributes="Bold" FontSize="16"/>
                                    <BoxView Grid.Row="1" Grid.ColumnSpan="2" HeightRequest="1" Margin="0,8"/>

                                    <VerticalStackLayout Grid.Row="2" Grid.Column="0" Spacing="4" Margin="0,0,10,0">
                                        <Label Text="{Binding [ProposalTitle]}" FontAttributes="Bold" FontSize="14" />
                                        <Label Text="{Binding [ProposalDetails]}" FontSize="14" LineBreakMode="WordWrap"/>
                                    </VerticalStackLayout>

                                    <HorizontalStackLayout Grid.Row="2" Grid.Column="1" Spacing="12" VerticalOptions="Center">
                                        <ImageButton Source="accept_icon.png" WidthRequest="32" HeightRequest="32" CommandParameter="{Binding .}" Clicked="OnAcceptProposalClicked"/>
                                        <ImageButton Source="red_cross.png" WidthRequest="32" HeightRequest="32" CommandParameter="{Binding .}" Clicked="OnRejectProposalClicked"/>
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <Grid x:Name="PopupCreateModal" Grid.RowSpan="2" IsVisible="False" Padding="20,40">
            <Border StrokeShape="RoundRectangle 12" Padding="20" HorizontalOptions="Center" VerticalOptions="Center">
                <ScrollView>
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="ORGANIZE EVENT 🔔" FontSize="18" FontAttributes="Bold" VerticalOptions="Center"/>
                            <Button Grid.Column="1" Text="X" Clicked="OnCloseModalClicked" BackgroundColor="Transparent" FontSize="16" FontAttributes="Bold"/>
                        </Grid>

                        <BoxView HeightRequest="1" Margin="0,2"/>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="EVENT TITLE *" FontSize="12" FontAttributes="Bold"/>
                            <Entry x:Name="TxtTitle" Placeholder="Enter title"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="ORGANIZER FULL NAME *" FontSize="12" FontAttributes="Bold"/>
                            <Entry x:Name="TxtOrgName" IsReadOnly="True"/>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*, *">
                            <VerticalStackLayout Spacing="4" Padding="0,0,5,0">
                                <Label Text="EMAIL *" FontSize="12" FontAttributes="Bold"/>
                                <Entry x:Name="TxtEmail" IsReadOnly="True"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4" Padding="5,0,0,0">
                                <Label Text="CONTACT NUMBER" FontSize="12" FontAttributes="Bold"/>
                                <Entry x:Name="TxtContact" IsReadOnly="True"/>
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="ASSIGNED LOCALE *" FontSize="12" FontAttributes="Bold"/>
                            <Entry x:Name="TxtLocaleDisplay" IsReadOnly="True"/>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*, *, *">
                            <VerticalStackLayout Spacing="4" Padding="0,0,4,0">
                                <Label Text="DATE *" FontSize="11" FontAttributes="Bold"/>
                                <DatePicker x:Name="PickerDate" Format="yyyy-MM-dd"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4" Padding="2,0,2,0">
                                <Label Text="START TIME *" FontSize="11" FontAttributes="Bold"/>
                                <TimePicker x:Name="PickerStart" Format="HH:mm"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="4" Padding="4,0,0,0">
                                <Label Text="END TIME *" FontSize="11" FontAttributes="Bold"/>
                                <TimePicker x:Name="PickerEnd" Format="HH:mm"/>
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*, *">
                            <VerticalStackLayout Spacing="4" Padding="0,0,5,0">
                                <Label Text="EXPECTED PARTICIPANTS *" FontSize="11" FontAttributes="Bold"/>
                                <Entry x:Name="TxtExpectedParts" Keyboard="Numeric" Placeholder="0"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4" Padding="5,0,0,0">
                                <Label Text="VOLUNTEER CAPACITY *" FontSize="11" FontAttributes="Bold"/>
                                <Entry x:Name="TxtMaxVol" Keyboard="Numeric" Placeholder="0"/>
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="EVENT DESCRIPTION / ANNOUNCEMENT *" FontSize="12" FontAttributes="Bold"/>
                            <Editor x:Name="TxtAnnouncement" AutoSize="TextChanges" HeightRequest="80"/>
                        </VerticalStackLayout>

                        <Label x:Name="LblCreateError" FontSize="13" IsVisible="False" HorizontalOptions="Center"/>

                        <Button Text="+ PUBLISH EVENT" Clicked="OnPublishEventClicked" FontAttributes="Bold" CornerRadius="6" HeightRequest="45" Margin="0,10,0,0"/>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>
    </Grid>
</ContentPage>